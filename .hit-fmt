include = "@/cli/examples/ytsaurus.hit-fmt"

# Keep this repository's naming, switch cases, lambda calls and ruler placement
# independent of YTsaurus.
ClassNameCase = Unchecked
ClassNamePrefixes = []
StructNameCase = Unchecked
StructNamePrefixes = []
EnumNameCase = Unchecked
EnumNamePrefixes = []
FunctionNameCase = Unchecked
NamespaceNameCase = Unchecked
NamespaceNamePrefixes = []
LocalVariableNameCase = Unchecked
LocalVariableNameExemptions = []
ParameterNameCase = Unchecked
GlobalVariableNameCase = Unchecked
StaticLocalVariableNameCase = Unchecked
PublicMemberVariableNameCase = Unchecked
ProtectedMemberVariableNameCase = Unchecked
ProtectedMemberVariableNameSuffixes = []
PrivateMemberVariableNameCase = Unchecked
PrivateMemberVariableNameSuffixes = []
StaticMemberVariableNameCase = Unchecked
EnumeratorNameCase = Unchecked
NamingAcronyms = []
CaseBlankLines = Preserve
LambdaCallSpaceBeforeArguments = NoSpace
RulerPlacement = Preserve

# Do not scan generated outputs, goldens or benchmarks.
Exclude = [
    "(^|/)build[^/]*(/|$)", "(^|/)testdata(/|$)", "(^|/)benchmarks(/|$)",
    "^unicode/unicode_data\\.cpp$"
]
