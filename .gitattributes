# CRLF goldens retain carriage returns as part of the line ending.
formatter/tests/testdata/**/*crlf.output.cpp whitespace=cr-at-eol
formatter/tests/testdata/**/*crlf.input.cpp whitespace=cr-at-eol

# Spacing fixtures intentionally include trailing whitespace and CRLF.
formatter/tests/testdata/spacing-options/*.input.cpp -whitespace
formatter/tests/testdata/spacing-options/*.output.cpp -whitespace

# Tokenizer fixtures preserve source whitespace, including CRLF and trailing spaces.
tokenizer/tests/testdata/*.in -whitespace
tokenizer/tests/testdata/*.out -whitespace
