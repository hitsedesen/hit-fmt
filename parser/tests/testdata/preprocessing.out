(translation-unit
  (preprocessing-directive "#include <something>")
  (preprocessing-directive "%:define DIGRAPH 1")
  (preprocessing-directive "#define APPLY(x) \\\n    ((x) + 1)")
  (preprocessing-conditional
    (leading-trivia
      (whitespace "\n\n")
    )
    (preprocessing-branch
      (preprocessing-directive
        (leading-trivia
          (whitespace "\n\n")
        )
        "#if FIRST"
      )
      (using-declaration
        "using" "Selected" "="
        (type-id "int")
        ";"
      )
      (preprocessing-conditional
        (preprocessing-branch
          (preprocessing-directive "#  if NESTED")
          (function-declaration
            (declaration-specifiers "int")
            (init-declarator
              (declarator
                (declarator-name "nested")
                (function-declarator
                  (parameter-list "(" ")")
                )
              )
            )
            ";"
          )
        )
        (preprocessing-directive "#  endif")
      )
    )
    (preprocessing-branch
      (preprocessing-directive "#elif SECOND")
      (using-declaration
        "using" "Selected" "="
        (type-id "long")
        ";"
      )
    )
    (preprocessing-branch
      (preprocessing-directive "#else")
      (using-declaration
        "using" "Selected" "="
        (type-id "short")
        ";"
      )
    )
    (preprocessing-directive "#endif")
  )
  (function-definition
    (leading-trivia
      (whitespace "\n\n")
    )
    (declaration-specifiers "void")
    (init-declarator
      (declarator
        (declarator-name "function")
        (function-declarator
          (parameter-list "(" ")")
        )
      )
    )
    (compound-statement
      "{"
      (preprocessing-conditional
        (preprocessing-branch
          (preprocessing-directive "#if ENABLED")
          (declaration-statement
            (declaration-specifiers "int")
            (init-declarator
              (declarator
                (declarator-name "value")
              )
              (initializer
                "="
                (call-expression
                  (identifier-expression "APPLY")
                  (argument-list
                    "("
                    (argument
                      (literal-expression "1")
                    )
                    ")"
                  )
                )
              )
            )
            ";"
          )
          (expression-statement
            (call-expression
              (identifier-expression "use")
              (argument-list
                "("
                (argument
                  (identifier-expression "value")
                )
                ")"
              )
            )
            ";"
          )
        )
        (preprocessing-branch
          (preprocessing-directive "#else")
          (return-statement "return" ";")
        )
        (preprocessing-directive "#endif")
      )
      "}"
    )
  )
  (preprocessing-directive
    (leading-trivia
      (whitespace "\n\n")
    )
    "#define declare_handle(name) class name;"
  )
  (namespace-declaration
    "namespace" "sample" "{"
    (unparsed-syntax "declare_handle" "(" "handle" ")")
    "}"
  )
  (function-definition
    (leading-trivia
      (whitespace "\n\n")
    )
    (declaration-specifiers "void")
    (init-declarator
      (declarator
        (declarator-name "split_conditional_block")
        (function-declarator
          (parameter-list "(" ")")
        )
      )
    )
    (compound-statement
      "{"
      (preprocessing-body
        (preprocessing-conditional
          (preprocessing-branch
            (preprocessing-directive "#if FIRST")
            (if-statement
              "if"
              (condition
                "("
                (identifier-expression "first")
                ")"
              )
              (compound-statement "{")
            )
          )
          (preprocessing-branch
            (preprocessing-directive "#else")
            (if-statement
              "if"
              (condition
                "("
                (identifier-expression "second")
                ")"
              )
              (compound-statement "{")
            )
          )
          (preprocessing-directive "#endif")
        )
        (expression-statement
          (call-expression
            (identifier-expression "use")
            (argument-list "(" ")")
          )
          ";"
        )
        "}"
      )
      (expression-statement
        (call-expression
          (identifier-expression "finish")
          (argument-list "(" ")")
        )
        ";"
      )
      "}"
    )
  )
  (namespace-declaration
    (leading-trivia
      (whitespace "\n\n")
    )
    "namespace" "detail" "{"
    (record-declaration
      "class" "Guard" "{"
      (access-specifier "public" ":")
      (function-definition
        (init-declarator
          (declarator
            (destructor-name "~" "Guard")
            (function-declarator
              (parameter-list "(" ")")
            )
          )
        )
        (compound-statement
          "{"
          (preprocessing-body
            (preprocessing-conditional
              (preprocessing-branch
                (preprocessing-directive "#if FEATURE")
                (if-statement
                  "if"
                  (condition
                    "("
                    (identifier-expression "ready")
                    ")"
                  )
                  (compound-statement "{")
                )
              )
              (preprocessing-branch
                (preprocessing-directive "#elif ALTERNATIVE")
                (if-statement
                  "if"
                  (condition
                    "("
                    (identifier-expression "alternate")
                    ")"
                  )
                  (compound-statement "{")
                )
              )
              (preprocessing-branch
                (preprocessing-directive "#else")
                (if-statement
                  "if"
                  (condition
                    "("
                    (identifier-expression "fallback")
                    ")"
                  )
                  (compound-statement "{")
                )
              )
              (preprocessing-directive "#endif")
            )
            (expression-statement
              (call-expression
                (identifier-expression "Release")
                (argument-list "(" ")")
              )
              ";"
            )
            "}"
          )
          "}"
        )
      )
      (function-definition
        (declaration-specifiers "void")
        (init-declarator
          (declarator
            (declarator-name "Run")
            (function-declarator
              (parameter-list "(" ")")
            )
          )
        )
        (compound-statement
          "{"
          (expression-statement
            (call-expression
              (identifier-expression "Work")
              (argument-list "(" ")")
            )
            ";"
          )
          "}"
        )
      )
      (function-definition
        (declaration-specifiers "void")
        (init-declarator
          (declarator
            (declarator-name "Stop")
            (function-declarator
              (parameter-list "(" ")")
            )
          )
        )
        (compound-statement
          "{"
          (expression-statement
            (call-expression
              (identifier-expression "Done")
              (argument-list "(" ")")
            )
            ";"
          )
          "}"
        )
      )
      "}" ";"
    )
    (record-declaration
      "struct" "Worker" "{"
      (function-definition
        (init-declarator
          (declarator
            (destructor-name "~" "Worker")
            (function-declarator
              (parameter-list "(" ")")
            )
          )
        )
        (compound-statement
          "{"
          (preprocessing-conditional
            (preprocessing-branch
              (preprocessing-directive "#if FEATURE")
              (expression-statement
                (call-expression
                  (identifier-expression "Release")
                  (argument-list "(" ")")
                )
                ";"
              )
            )
            (preprocessing-branch
              (preprocessing-directive "#else")
              (expression-statement
                (call-expression
                  (identifier-expression "Reset")
                  (argument-list "(" ")")
                )
                ";"
              )
            )
            (preprocessing-directive "#endif")
          )
          "}"
        )
      )
      (function-definition
        (declaration-specifiers "void")
        (init-declarator
          (declarator
            (declarator-name "Run")
            (function-declarator
              (parameter-list "(" ")")
            )
          )
        )
        (compound-statement
          "{"
          (preprocessing-body
            (preprocessing-conditional
              (preprocessing-branch
                (preprocessing-directive "#ifndef FEATURE")
                (while-statement
                  "while"
                  (condition
                    "("
                    (identifier-expression "ready")
                    ")"
                  )
                  (compound-statement "{")
                )
              )
              (preprocessing-branch
                (preprocessing-directive "#else")
                (while-statement
                  "while"
                  (condition
                    "("
                    (identifier-expression "fallback")
                    ")"
                  )
                  (compound-statement "{")
                )
              )
              (preprocessing-directive "#endif")
            )
            (expression-statement
              (call-expression
                (identifier-expression "Poll")
                (argument-list "(" ")")
              )
              ";"
            )
            "}"
          )
          "}"
        )
      )
      (function-definition
        (declaration-specifiers "void")
        (init-declarator
          (declarator
            (declarator-name "Stop")
            (function-declarator
              (parameter-list "(" ")")
            )
          )
        )
        (compound-statement
          "{"
          (expression-statement
            (call-expression
              (identifier-expression "Done")
              (argument-list "(" ")")
            )
            ";"
          )
          "}"
        )
      )
      "}" ";"
    )
    "}"
  )
)
