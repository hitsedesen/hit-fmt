using Output = int;
Output BUILD(int value);
Output build(int value);

bool inside(int Position, int limit)
{
    return Position < 0 || Position > limit;
}

bool compare(int left, int middle, int right)
{
    return left < middle > (right);
}

bool compare_global(int left, int middle)
{
    return left < middle > ::global_value;
}

template<class Element>
bool inspect()
{
    auto scalar = std::is_same_v<String, decltype(value)>;
    Dictionary<Key, Payload> result;
    catalog::Sequence<Element> values;
    Sequence<Element>::Cursor position;
    catalog::Buffer<int, extent + 1> buffer;
    Storage<extent + 1> storage;
    ExternalCount plain;
    ExternalCount assigned = Estimate(first, second);
    ExternalCount direct(first, second);
    ExternalCount braced{first, second};
    [[maybe_unused]] ExternalCount annotated = Estimate(first, second);
    ExternalCount /* type */ commented = Estimate(first, second);
    ExternalCount * ambiguousPointer;
    ExternalCount & ambiguousReference;
    ExternalCount && ambiguousConjunction;
    ExternalCount* pointer = Acquire(first, second);
    ExternalCount & reference = Acquire(first, second);
    ExternalCount&& movable = Acquire(first, second);
    [[maybe_unused]] ExternalCount /* type */ * annotatedPointer = Acquire(first, second);
    ::external::Buffer* const global = Acquire(first, second);
    ExternalCount* nested = Adapt(Acquire(first, second), third);
    ExternalCount* conditional = ready ? Acquire(first, second) : fallback;
    ExternalCount* grouped = (Acquire(first, second), fallback);
    ExternalCount* multiple = Acquire(first, second), *other = fallback;
    ExternalCount * condition ? target = Acquire(first, second) : fallback;
    ExternalCount* opaque = PREFIX Acquire(first, second);
    ExternalCount* incomplete = Acquire(first, second) +;
    ExternalCount* comparison == Acquire(first, second);
    ExternalCount* compound += Acquire(first, second);
    ExternalCount* nestedOnly(Acquire(target = first, second));
    ExternalCount shadowedType;
    shadowedType * operand;
    external::Range bounds(1, 2);
    Distribution<int> samples(1, 2);
    external::Distribution<int> qualified(static_cast<int>(extent * 0.5), static_cast<int>(extent * 1.5));
    ::external::Distribution<long> global(1, 2);
    external::Distribution<Element> dependent(1, 2);
    external::Distribution<int>* pointer = make(1, 2);
    external::Distribution<int>& reference = sample;
    external::Range parameters(int, int);
    external::Range unresolved(Unknown);
    left < middle > right(1, 2);
    external::left < middle > right(1, 2);
    external::value * factor;
    external::value & mask;
    external::value && enabled;
    external::value<int> * factor;
    external::value<int> & mask;
    external::value<int> && enabled;
    auto constructed = CONSTRUCT{item};
    auto lower_constructed = construct{item};
    return scalar;
}
