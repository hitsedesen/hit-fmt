namespace example {
template<class T>
struct Record {
    int bits : 3;
    int Record::* member;
    Record();
    Record(int value) : bits{value}, member(nullptr) {}
    ~Record();
    explicit operator bool() const;
    Record& operator=(const Record& other);
    int operator()(int value) const;
    T get() const { if (member) return {}; else return T{}; }
};
}

