namespace example {
template<class T>
struct Record {
    int bits : 3;
    int Record::* member;
    Record();
    Record(int value) : bits{value}, member(nullptr) {}
    ~Record();
    explicit operator bool() const;
    Record& operator=(const Record& other);
    int operator()(int value) const;
    T get() const { if (member) return {}; else return T{}; }
};
}

using Type = int;
Type* first = nullptr, second[3]{};
auto function(Type* value, int count = 1) -> Type*;
void (*callback)(int);
int (*table[4])(double);
void consume(int*, void (*)(int), int (&)[4], int example::Record<int>::*);
auto [first_value, second_value] = pair;
auto&& [left, right] = get_pair();
int [[maybe_unused]] tagged;
API_EXPORT void exported_by_macro();
API_WITH_ARGUMENTS(dllexport) int another_export();
struct URL {
    URL() {}
};
REGISTER_TYPE(URL)
const int registered_value = 1;
const Items expected_items = {
    Item()("key", "one")("value", "1"),
};

struct Version {
    int major;
    int minor;
};
template<Version version>
struct Versioned;
template<>
struct Versioned<Version{1, 0}> {};

template<size_t Bits, typename Signed>
template<class T>
requires (std::is_arithmetic_v<T>)
constexpr integer<Bits, Signed>::operator T() const noexcept {
    using UnsignedT = std::make_unsigned_t<T>;
    return {};
}

template<size_t Bits, typename Signed>
constexpr integer<Bits, Signed>::operator long double() const noexcept {
    return 0;
}
