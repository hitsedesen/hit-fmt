struct PairCallbacks {
    PairCallbacks() : callback([this] { stop(); }, [this] { start(); }) {}
};
struct SeparateMembers {
    SeparateMembers() : first([] { return 1; }), second([] { return 2; }) {}
};
struct NoexceptCallbacks {
    NoexceptCallbacks() noexcept : callback([this]() noexcept { stop(); }, [this]() noexcept { start(); }) {}
};
struct NestedCallback {
    NestedCallback() : first(0), callback(wrap(bind([id = 1](int* value) { consume(value, id); }))) {}
};
struct QualifiedCallback {
    QualifiedCallback() noexcept(noexcept([] { return 1; }())) : first([] { return 1; }), second([] { return 2; }) {}
};
struct TryCallbacks {
    TryCallbacks() try : first([] { return 1; }), second([] { return 2; }) {} catch (...) {}
};
struct Controls {
    int values[3];
    int (*routes[2])(int);
    unsigned flags : 2;
};
auto query() noexcept(noexcept(check(1 ? 2 : 3))) -> int;
void attributed() [[tag]];
template<class T> void constrained() requires (T::flag ? true : false) {}
