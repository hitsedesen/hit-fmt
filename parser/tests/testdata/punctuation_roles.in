template<class Element>
struct Derived : Base<Element>
{
    [[nodiscard]] int* transform(int& value, int shift)
    {
        int bits : 3;
        auto lambda = [&value](int item) { return item; };
        if (value < 2) {
            return (value ? *transform(value, shift) : value >> shift);
        }
        return static_cast<int>(value);
    }
};

void Compare(const ::google::protobuf::Map<TKey, TValue>& value);

int Select(int row, int offset)
{
    return cells[row][ offset & 0xff];
}
