namespace Samples {
using Shared = int;
DEFINE_CASE /* header */ (Shared, Nested(1, (2 + 3))) {
    Shared* pointer;
    auto sum = ReadFirst() + ReadSecond();
    if (sum > 0) {
        Write(sum);
    }
}
DEFINE_CASE() { return; }
DEFINE_BENCHMARK(TFixture, Run)(TState& state) {
    Consume(state);
}
static inline DEFINE_CASE(Suite, Curried) /* parameters */ (void (*callback)(int), Shared& value) () {
    Shared* pointer;
    callback(value);
}
struct Holder {
    DEFINE_METHOD(Member, Case)() {
        int count = 1;
        while (count > 0) { --count; }
    }
};
DEFINE_CASE(Suite, DeclarationOnly);
DEFINE_CASE(Suite, DeclarationOnly)(Shared value);
UNLISTED_CASE(Suite, Opaque) { untouched = left+right; }
static DEFINE_CASE(Suite, const Shared& value) { Use(value); }
static inline DEFINE_CASE(Suite, Helper(alpha + beta)) { Use(value); }
static DEFINE_CASE(Suite, DeclarationOnly);
int tail;
}

EXPORT DEFINE_CASE() {}

Result
OrdinaryFunction() { return {}; }

OpenScope

DEFINE_CASE() {}

CloseScope

OpenScope
// independent test
DEFINE_CASE(Suite, Test) { Use(value); }
CloseScope

DEFINE_METHOD(Suite) {
    using Local = int;
    DEFINE_CASE /* nested header */ (Shared, Nested(1, (2 + 3))) /* parameters */ (int Shared) {
        Local* pointer;
        Write(pointer);
    }
    DEFINE_METHOD(NestedSuite) {
        DEFINE_CASE(Second) { return; }
    }
    DEFINE_CASE(DeclarationOnly);
    auto result = DEFINE_CASE(value);
    auto curried = DEFINE_CASE(value)(other);
    UNLISTED_CASE(Opaque) { untouched = left+right; }
}

OpenScope
#if FEATURE
static DEFINE_CASE(Suite, Conditional) { auto* pointer = &object; }
#else
DEFINE_METHOD(Alternative) {}
#endif
CloseScope

