struct Entries {};
enum Kind { value };
struct Pair { Pair(int, int); operator int() const; };
template<class Item> struct Box {
    using type = int;
    static constexpr int value = 1;
};
struct Outer {
    using Inner = int;
    struct Nested { using Leaf = int; };
    enum { value = 1 };
};
struct Outer;
namespace local { int move(int); }

void function(int count, Entries entries) {
    int empty();
    int typed(int, const Entries&);
    int variadic(int, ...);
    int any(...);
    int n = 1;
    int postfix(int(n++));
    int function_parameter(int(n));
    int constructed(Pair(n, n));
    int function_argument(Pair(int, int));
    int template_value(Box<int>::value);
    int template_member_type(Box<int>::type);
    int template_type(Box<int>);
    int value(n);
    int literal(2);
    int pair(n, 2);
    int first(), second(n), third(int);
    using Number = int;
    int alias(Number);
    int moved(local::move(n));
    int member(Kind::value);
    int qualified_type(Outer::Inner);
    int deep_type(Outer::Nested::Leaf);
    int qualified_value(Outer::value);
    int unresolved(External);
    int indirect(External * n);
    int unknown_call(External(n));
    int definite_call(External(1));
    int mixed_unknown(External), mixed_known(int);
    int (nested_unknown)(External);
    int (nested_value)(n);
    int (nested_function)(int);
    int cast(int(1));
    int braced(Number{2});
    int nested(Number(3));
    int product(int(n * n));
    int multiplied(int() * n);
    int compared(int(n == n));
    int assigned(int(n = n));
    int parenthesized(int(n));
    int parameter(int (*callback)(int, int) = nullptr);
    int exception_spec(int (*callback)(int) noexcept(noexcept(n, n)));
    int exception_value(int(noexcept(n, n)));
    int defaulted(int count = Number{1}, int next = 2);
    for (int index = 0; index < count; ++index)
        use(index);
    for (auto&& [key, value] : entries)
        use(key, value);

    if (auto item = entries.find("key"); item != entries.end() && IsReady() && HasCapacity()) {
        use(item);
    }
    if (update([] { touch(); return 1; }); ready && count > 0) {
        use(count);
    }
    switch (int index = count + 1; index + ExtraCapacity()) {
    case 0:
        break;
    }
    if (; ready) {
        use(count);
    }
    if (ready && count > 0) {
        return object.value + 1;
    } else if (fallback) {
        throw Error{};
    }

    switch (count) {
    case 0:
        break;
    default:
        break;
    }

    while (ready) {
        if (skip)
            continue;
        co_await next();
    }
    do {
        --count;
    } while (count > 0);

label:
    goto label;
}

void argument(int n) {
    int value(n);
}

void comment_boundaries(bool ready, bool fallback) {
    if (ready) goto finish;
    if (fallback) goto finish;

    // Start the next phase.
    Work();
    if (ready) if (fallback) Work();
    // Outside both controls.
    Work();
    if (ready) Work(); // attached
    Work();
    if (ready) /* body comment */ Work();
    if (ready) Work();
    // Explain the alternative.
    else Work();
    if (ready) Work(); else Work();
    /* Start another phase. */
    Work();
finish:
    Work();
}

template<class T> void conditions(int count) {
    if constexpr (Box<T>::value && !traits::same<T, T>) {
        use(count);
    }
    if (Box<T>::value && enabled) {
        use(count);
    }
    if (int value = count) {
        use(value);
    }
    if (int (value) = count) {
        use(value);
    }
    if (auto* value = Acquire()) {
        use(value);
    }
    if (ExternalType value = Acquire()) {
        use(value);
    }
    if (int previous = count; int next = previous) {
        use(next);
    }
    while (int value{ReadValue()}) {
        use(value);
    }
    compare(count, (Box<T>{first, second}));
    compare(count, (types::collection{first, second}));
    compare(count, (types::collection<int>{first, second}));
    compare(count, Limits<ExternalType>::max());
    compare(count, left < limit > ::Result());
}
