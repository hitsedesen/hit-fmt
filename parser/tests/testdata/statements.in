void function(int count, Entries entries) {
    for (int index = 0; index < count; ++index)
        use(index);
    for (auto&& [key, value] : entries)
        use(key, value);

    if (ready && count > 0) {
        return object.value + 1;
    } else if (fallback) {
        throw Error{};
    }

    switch (count) {
    case 0:
        break;
    default:
        break;
    }

    while (ready) {
        if (skip)
            continue;
        co_await next();
    }
    do {
        --count;
    } while (count > 0);

label:
    goto label;
}

void macro_statements() {
    with_lock(Mutex_) {
        use();
    }
    MACRO_CONSTEXPR_IF (enabled) {
        first();
    } else {
        second();
    }
    MACRO_TRY {
        work();
    }
    MACRO_IF(enabled)
        return;
    else
        use_default();
    if (first_field) {
        use_first();
    } else
        VALIDATE_FIELD(Second)
    else
        VALIDATE_FIELD(Third)
    else
        use_default();
}

Y_UNIT_TEST(FormatsMacroBody) {
    check();
}

