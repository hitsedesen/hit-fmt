void function(int count, Entries entries) {
    for (int index = 0; index < count; ++index)
        use(index);
    for (auto&& [key, value] : entries)
        use(key, value);

    if (ready && count > 0) {
        return object.value + 1;
    } else if (fallback) {
        throw Error{};
    }

    switch (count) {
    case 0:
        break;
    default:
        break;
    }

    while (ready) {
        if (skip)
            continue;
        co_await next();
    }
    do {
        --count;
    } while (count > 0);

label:
    goto label;
}
