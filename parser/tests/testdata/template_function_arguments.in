template<class Value, class Signature> struct Setter;
struct Owner { using Type = int; static void Run(int); };
template<class T, class R, class U>
void dispatch()
{
    Setter<T, R(ErrorOr<U>&&)>::Run(promise, callback, move(value));
    Setter<T, R()>::Run(promise, callback);
    Setter<T, R(T first, const U& second)> named;
    scope::Setter<T, R(ErrorOr<U>&&)>::Run(promise, callback, move(value));
    ::Setter<T, R(ErrorOr<U>&&)>::Run(promise, callback, move(value));
    Setter<T, R(Pair<U, T>&&, Box<Box<U>>)>::Run(promise, callback);
    Setter<T, R() > ::Run(promise, callback);
    Setter<T, R(ErrorOr<U>&&)> local;
    Owner::Run(1);
    Owner::Type(number);
    auto comparison = left < right > ::Run();
    Setter<T, (left < right)>::Run(promise, callback);
}
template<class Signature> struct Callback;
Callback<bool(const DispatchPlan& plan, JobQueue* queue, unsigned long long ticket)> submit;
Callback<int(const scheduling::WorkUnit* work, JobQueue* queue, bool urgent)> schedule;
Callback<bool(const Batch<unsigned>& incoming, const Batch<long>& deferred, JobQueue* destination)> route;
using DispatchSignature = int(JobQueue* queue, const DispatchPlan& plan, bool urgent) noexcept;
Callback<int(1 + 2)> constant;
Callback<int(unresolved)> unresolved;
Callback<int(left * right)> product;
Callback<int(left & right)> bitwise;
Callback<int(left && right)> logical;
Callback<decltype(compute(1, 2))> result;
void external_types()
{
    Setter<T, R()>::Run(promise, callback);
    Setter<T, R(ErrorOr<U>&&)>::Run(promise, callback, move(value));
}
void default_arguments()
{
    Channel<>::Send();
    ::scope::Channel< /* defaults */ >::Send(1);
    Channel<int>::Send();
    Dispatch<>(1);
    object.Send<>(1);
    left < right > ::Send();
}
