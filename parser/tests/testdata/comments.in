

// leading declaration
int value; // trailing declaration
void empty()
{

    // dangling in empty body
}

void listComments()
{
    auto result = consume(alpha, /* next argument */ beta, gamma);
    result = consume(alpha, /* first */ /* second */ beta, gamma);
    result = consume(alpha, // stays with alpha
        beta, gamma);
    result = consume(alpha, /* prefix */ // stays with alpha
        beta, gamma);
    result = consume(alpha /* previous argument */, beta, gamma);
    result = consume((alpha, /* expression */ beta), gamma);
    auto values = {alpha, /* next element */ beta, /* trailing */};
}
