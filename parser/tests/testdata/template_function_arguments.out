            "("
            (argument
              (literal-expression "1")
            )
            ")"
          )
        )
        ";"
      )
      (expression-statement
        (call-expression
          (member-expression
            (unparsed-syntax "left" "<" "right" ">")
            "::"
            (identifier-expression "Send")
          )
          (argument-list "(" ")")
        )
        ";"
      )
      "}"
    )
  )
)
