template<class T>
requires requires(T value) {
    value.touch();
    { value.touch() } noexcept;
    typename T::value_type;
    requires requires { typename T::other_type; };
}
struct Container { T member; };

template<class T>
requires (requires { typename T::value_type; }) && true
int inspect(T value) { return 1; }

int outside;

template<class Tag, Tag... Defaults, ForeignConstraint Base, class... Branches>
requires (
    CompatibleHierarchy<Base, Branches...> &&
    // The fallback branch must have a compatible default.
    (
        !OptionalChoice<Tag, Defaults...>::DefaultChoiceValue.has_value() ||
        HasDefaultChoice<Tag, Defaults..., Branches...>)
    )
void Configure();

template<typename /* type pack */ ... Items>
void Select() requires (Ready<Items...> && Compatible<External, Items..., 0>)
{}

template<class... Items>
requires (requires { sizeof...(Items); } && Ready<Items...>)
struct Pack;

template<int Value>
requires (lower < Value > upper)
void Ordered();

template<class T>
requires traits::Ready<traits::Value<T>>
[[nodiscard]] traits::Result<T> Convert(T value) { return {}; }

template<class T>
requires (Ready<T> && enabled) /* declaration boundary */
[[nodiscard]] [[deprecated("use another overload")]]
int Inspect(T value);

template<class T>
requires requires(T value) {
    value[0];
    [] { return true; }();
}
[[nodiscard]] T Copy(T value) { return value; }
