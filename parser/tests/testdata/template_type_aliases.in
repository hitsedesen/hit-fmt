template<class T> struct Box {};
void nested_first()
{
    Select<Box<int>, Second>(first, second);
    Select<Box<int>>(first, second);
    Select<Box<Box<int>>>(first, second);
    Select<Box<int> >(first, second);
    object.Select<Box<int>, Second>(first, second);
    scope::Select<Box<int>, Second>(first, second);
    unknown<External<int>, Second>(first, second);
    unknown<External<int>, value>(first, second);
    auto comparison = left < right > tail;
}
void shadowed()
{
    int Box = 1;
    Select<Box<int>, Second>(first, second);
    Select<Box<int>, value>(first, second);
}

template<class... Elements>
void pack_arguments()
{
    auto plain = Ready<Elements...> && Other<External, Elements...>;
    auto nested = Ready<Box<Elements>...> && Other<External, Box<Elements>...>;
    auto shared = Ready<Box<Box<Elements>>...>;
}

void escaped_pack_name()
{
    auto comparison = lower < Elements > upper;
}

int Hidden = 1;
template<template<class... Hidden> class Factory>
void nested_pack_scope()
{
    auto comparison = lower < Hidden > upper;
    auto specialized = Ready<Factory<int>>;
}

template<int... Values>
void value_packs()
{
    auto undecided = Check<Values...> && true;
    auto comparisons = ((lower < Values) && ...);
}

template<class T, class... Types>
void qualified_arguments()
{
    auto reference = Ready<const T&>;
    auto pointer = Ready<T* const>;
    auto rvalue = Ready<volatile T&&>;
    auto second = Ready<0, const T&>;
    auto pack = Ready<Types&...>;
    auto nested = Ready<const Box<T>&>;
    auto fundamental = Ready<const int*>;
    auto comparison = lower < value & mask > upper;
    auto shadow = [] (int First) { return lower < First & mask > upper; };
}
