# Approximation of the LLVM C++ coding style / clang-format's LLVM preset.
# Use with --config, or copy to .hit-fmt in the source tree.

# Indentation and limits
IndentWidth = 2
ColumnLimit = 80
IndentationKind = Spaces
TrailingWhitespace = Trim

# Includes, directives, and comments
# LLVM include order depends on categories, so preserve it.
IncludeOrder = Preserve

# Records, namespaces, and declarators
PointerReferenceDeclaratorLocation = Right
IndentAccessModifiers = NoIndent
IndentMembers = Indent
ClassBracePlacement = Attach
EnforceClassBracePlacement = true
ClassBraceSpacing = SingleSpace
EnforceClassBraceSpacing = true
StructBracePlacement = Attach
EnforceStructBracePlacement = true
StructBraceSpacing = SingleSpace
EnforceStructBraceSpacing = true
UnionBracePlacement = Attach
EnforceUnionBracePlacement = true
UnionBraceSpacing = SingleSpace
EnforceUnionBraceSpacing = true
EnumBraceSpacing = SingleSpace
NamespaceBracePlacement = Attach
EnforceNamespaceBracePlacement = true
NamespaceBraceSpacing = SingleSpace
EnforceNamespaceBraceSpacing = true
NamespaceComments = Fix
ShortNamespaceLines = 1
# LLVM base-list layout is context-dependent; keep it source-owned.
InheritanceList = Preserve

# Functions and parameters
FunctionBracePlacement = Attach
EnforceFunctionBracePlacement = true
FunctionBraceSpacing = SingleSpace
EnforceFunctionBraceSpacing = true
FunctionParameterSplit = Pack
EnforceFunctionParameterSplit = true
FirstFunctionParameterPosition = NameLineIfFits
FunctionParameterIndent = Continuation
FunctionParameterNewLineIndent = 4
MergeFunctionParameters = true
FunctionSpaceBeforeParameters = NoSpace
SpaceInsideFunctionParameters = NoSpace
EnforceSpaceInsideFunctionParameters = true

# Lambdas
LambdaBracePlacement = Attach
EnforceLambdaBracePlacement = true
LambdaBraceSpacing = SingleSpace
EnforceLambdaBraceSpacing = true
LambdaSpaceBeforeParameters = NoSpace
SpaceInsideLambdaParameters = NoSpace
SpaceAroundCaptureList = NoSpace
SpaceAroundCaptureAssignment = Space

# Calls and chains
CallArgumentSplit = Pack
EnforceCallArgumentSplit = true
FirstCallArgumentPosition = CallLine
CallArgumentIndent = Continuation
FunctionCallSpaceBeforeParameters = NoSpace
SpaceInsideCallArguments = NoSpace
EnforceSpaceInsideCallArguments = true

# Control flow
LabelColonSpacing = NoSpace
IndentCaseLabels = NoIndent
ControlBlockBracePlacement = SameLine
EnforceControlBlockBracePlacement = true
ControlBlockKeywordSpacing = Space
ControlConditionIndent = Continuation

# Blocks and statements
IndentBlockBodies = true
StatementAttributeIndent = Block

# Initializers, new, and delete
InitializerListSplit = Pack
EnforceInitializerListSplit = true
InitializerListIndent = Continuation

# Expressions and operators
ExpressionLayoutCondition = Overflow
BinaryOperatorPlacement = Trailing
AssignmentOperatorPlacement = Trailing
TernaryOperatorPlacement = Leading
EnforceTernaryOperatorPlacement = true
TernarySplit = AsNeeded
EnforceTernarySplit = true
# Naming checks
# LLVM uses upper-initial types and variables, lower-initial functions.
# Naming checks only cover unambiguous definitions/declarations; see docs.
ClassNameCase = PascalCase
StructNameCase = PascalCase
UnionNameCase = PascalCase
EnumNameCase = PascalCase
ConceptNameCase = PascalCase
FunctionNameCase = camelCase
VariableNameCase = PascalCase
