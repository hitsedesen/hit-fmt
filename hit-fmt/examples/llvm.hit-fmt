# LLVM-inspired approximation, not clang-format compatibility.
# Canonical groups flatten fitting lists; delimiter alignment has a fixed fallback.
# Directives/protected regions are byte-exact. See --help-config.
# Include categories, contextual lambda indentation and brace removal remain unsupported.
# Comments/literals are not reflowed to guarantee the column limit.
Layout = Canonical
IndentWidth = 2
ColumnLimit = 80
WidthDiagnostics = Report
IndentationKind = Spaces
# Unix spelling for editable whitespace atoms only; token-owned CR, directives,
# protected/partial gaps and bare CR can remain. No missing final newline is added.
LineEnding = LF
TrailingWhitespace = Trim
ListBreak = IfNeeded
ListPacking = Fill
ListFirstItem = InlineIfFits
ListCloser = SameLine
ListAlignment = Delimiter
ContinuationOffset = 4
AlignmentFallbackOffset = 4
# Context-dependent header lists remain source-owned explicitly.
BaseListsLayout = Preserve
ConstructorListsLayout = Preserve
BodyShape = CompactIfFits
EmptyBodyShape = CompactIfFits
PointerReferenceDeclaratorLocation = Right
IndentAccessModifiers = NoIndent
IndentMembers = Indent
IndentNamespaces = NoIndent
IndentCaseLabels = NoIndent
StatementAttributeIndent = Block
IncludeOrder = Preserve
NamespaceComments = Fix
ShortNamespaceLines = 1
RemoveNullDeclarations = true

ClassBraceSpacing = Space
StructBraceSpacing = Space
UnionBraceSpacing = Space
EnumBraceSpacing = Space
FunctionBraceSpacing = Space
LambdaBraceSpacing = Space
NamespaceBraceSpacing = Space
FunctionSpaceBeforeParameters = NoSpace
SpaceInsideFunctionParameters = NoSpace
LambdaSpaceBeforeParameters = NoSpace
SpaceInsideLambdaParameters = NoSpace
SpaceAroundCaptureList = NoSpace
SpaceAroundCaptureAssignment = Space
FunctionCallSpaceBeforeParameters = NoSpace
SpaceInsideCallArguments = NoSpace
ControlBlockKeywordSpacing = Space
LabelColonSpaceBefore = NoSpace
LabelColonSpaceAfter = NoSpace
InitializerBracesSpacing = NoSpace
BraceInitializerSpacing = NoSpace
CommaSpaceBefore = NoSpace
CommaSpaceAfter = Space
AssignmentOperatorSpacing = Space
ExpressionsBreak = IfNeeded
ExpressionsPacking = Fill
BinaryOperatorSide = Trailing
AssignmentOperatorSide = Trailing
TernaryOperatorSide = Leading
TernaryLayout = Flexible
InitializersTrailingComma = Preserve
# Closer placement is independent of trailing-comma presence.
InitializersCloser = SameLine

# Diagnostics only: upper-initial types/variables, lower-initial functions.
# No role-aware STL exceptions, typedef/enumerator rules or semantic name checks.
# ConceptNameCase is an approximation, not a separate upstream mandate.
ClassNameCase = PascalCase
StructNameCase = PascalCase
UnionNameCase = PascalCase
EnumNameCase = PascalCase
ConceptNameCase = PascalCase
FunctionNameCase = camelCase
VariableNameCase = PascalCase
