# YTsaurus-inspired approximation for yt/yt, yt/chyt, yt/yql and library/cpp/yt.
# Not intended for yt/cpp, util or other library/cpp. See --help-config.
# Based on yt/styleguide/cpp.md at YTsaurus f7d51a676a55 (2026-10-31).
# https://github.com/ytsaurus/ytsaurus/blob/f7d51a676a55f80aef23354f91021798592b1034/yt/styleguide/cpp.md
# Fitting calls/parameters and accessor chains flatten; base/constructor lists break.
# Field paths and single-call chains wrap only when they do not fit.
# Mixed links (. / -> / invocation) participate in the same call chain.
# Receiver construction does not count as a chained call.
# Message layouts and paired visual scopes remain explicit library annotations.
# Chains use general AllSafe selection, including . / -> and repeated invocation.
# Approximation: macro languages and semantic grouping are not fully enforced;
# protected macro bytes are not style conformance.
Layout = Canonical
IndentWidth = 4
ColumnLimit = 120
WidthDiagnostics = Report
IndentationKind = Spaces
# Use LF for editable whitespace; protected regions keep their original bytes.
LineEnding = LF
# TrailingCommentSpaces stays omitted: retain existing ordinary comment gaps.
TrailingWhitespace = Trim
ListBreak = IfNeeded
ListPacking = VerticalWhenBroken
ListFirstItem = NextLine
CallsFirstItem = NextLine
CallsSoleArgumentFirstItem = InlineIfFits
ListCloser = SameLine
# Multiline captures close before the parameter/header line, not the last item.
CapturesCloser = OwnLine
ListAlignment = Block
ContinuationOffset = 4
AlignmentFallbackOffset = 4
# Broken template headers and uses have independent vertical list policies.
BreakAfterTemplateHeader = true
TemplateParametersLayout = Canonical
TemplateParametersBreak = IfNeeded
TemplateParametersPacking = VerticalWhenBroken
TemplateParametersFirstItem = NextLine
TemplateParametersCloser = SameLine
TemplateParametersAlignment = Block
TemplateParametersContinuationOffset = 4
TemplateParametersAlignmentFallbackOffset = 4
TemplateArgumentsLayout = Canonical
TemplateArgumentsBreak = IfNeeded
TemplateArgumentsPacking = VerticalWhenBroken
TemplateArgumentsFirstItem = NextLine
TemplateArgumentsCloser = SameLine
TemplateArgumentsAlignment = Block
TemplateArgumentsContinuationOffset = 4
TemplateArgumentsAlignmentFallbackOffset = 4
# Base lists always start on a new line, with leading colon/comma punctuation.
BaseListsBreak = Always
BaseListsPacking = VerticalWhenBroken
BaseListsFirstItem = NextLine
BaseListsColonSide = Leading
BaseListsCommaSide = Leading
# Even fitting constructor entries break, inheriting vertical/next-line/block + 4.
ConstructorListsBreak = Always
ConstructorListsColonSide = Leading
ConstructorListsCommaSide = Leading
# Keep the first control clause inline; use one normal indent for continuations.
ControlHeadersBreak = IfNeeded
ControlHeadersFirstItem = InlineIfFits
ControlHeadersAlignment = Block
ControlHeadersCloser = SameLine
# Short accessor chains stay inline; the library builders below require breaks.
ChainsBreak = IfNeeded
ChainsPacking = VerticalWhenBroken
ChainsAlignment = Block
# Reflow nested initializers; fitting lists stay compact.
InitializersLayout = Canonical
InitializersCloser = OwnLine
InitializersTrailingComma = WhenMultiline
# Every broken initializer owns its closer, independently of trailing commas.
ClassBracePlacement = NextLine
StructBracePlacement = NextLine
UnionBracePlacement = NextLine
EnumBracePlacement = NextLine
EnumeratorsBreak = Always
EnumeratorsCloser = OwnLine
FunctionBracePlacement = NextLine
NamespaceBracePlacement = Attached
LambdaBracePlacement = Attached
ControlBracePlacement = NextLineIfHeaderBroken
CaseBlockBracePlacement = Attached
BodyShape = Expanded
EmptyBodyShape = CompactIfFits
LambdaBodiesLayout = Canonical
LambdaBodyShape = Expanded
LambdaEmptyBodyShape = CompactIfFits
PointerReferenceDeclaratorLocation = Left
IndentAccessModifiers = NoIndent
IndentMembers = Indent
IndentNamespaces = NoIndent
NamespaceBlankLinesAfterOpen = 1
NamespaceBlankLinesBeforeClose = 1
DefinitionBlankLines = 1
MemberDefinitionBlankLines = Minimum:1
# Retain authored field/method and method-definition groups; their semantic
# justification remains a human decision. Other boundaries allow one gap.
MaxEmptyLines = 1
MemberGroupMaxEmptyLines = 2
BlockBlankLinesAfter = 1
ControlStatementBlankLinesBefore = 1
MacroBlankLinesAround = 1
BlankLineMacroNames = ["YT_LOG_*", "YT_TLOG_*", "THROW_ERROR_EXCEPTION", "YT_VERIFY"]
CaseBlankLines = 1
# Add namespace boundary rulers; declaration grouping stays with the author.
RulerPlacement = NamespaceBoundaries
RulerLength = 80
RulerBlankLinesBefore = 1
RulerBlankLinesAfter = 1
IndentCaseLabels = Indent
StatementAttributeIndent = Block
NamespaceComments = Fix
# Paired header first, then yt, library, util and contrib groups in that order.
# YT source/protobuf aliases share full-directory groups, ordered nearest first.
# Shared YT libraries keep directory groups; other library/cpp code groups
# by project. Headers within each group sort alphabetically.
# Pass project-relative input filenames so directory distances share that root.
# Same-directory paths use quotes; bare local/system names retain delimiters.
IncludeOrder = Sort
IncludeDelimiters = QuotedLocal
IncludeMatchingHeader = First
IncludeGrouping = Directory
IncludeGroupOrder = Configured
IncludeGroups = [
    { Prefixes = ["yt/yt/", "yt/yt_proto/yt/"], Depth = 127 },
    { Prefix = "library/cpp/yt/", Depth = 127 },
    { Prefix = "library/cpp/", Depth = 1 },
    { Prefix = "library/", Depth = 1 },
    { Prefix = "util/", Depth = 1 },
    { Prefix = "contrib/libs/", Depth = 1 }
]
IncludeDirectoryOrder = NearestFirst
IncludeInGroupOrder = Alphabetical
IncludePathBase = ProjectRoot
IncludeStandardHeaders = Last
AddMissingControlBraces = true
EmptyControlBody = EmptyBlock
RemoveNullStatements = true
RemoveNullDeclarations = true

# Nonempty CallLikeMacroNames is rejected by the public pipeline. Protect the
# affected invocation byte-for-byte instead; this is NOT macro-language formatting.
# Other semantic macro protection remains intact (not aesthetic name exceptions).
CallLikeMacroNames = []
# GoogleTest declarations introduce function bodies, not call expressions.
FunctionBodyMacroNames = [
    "TEST", "TEST_F", "TEST_P", "TYPED_TEST", "TYPED_TEST_P"
]
# These invocations open/close generated classes, rather than function calls.
ClassMacroNames = ["BEGIN_SETTER:END_SETTER"]
# The last argument is an enum sequence; align its explicit value fields.
EnumMacroNames = [
    "DEFINE_ENUM", "DEFINE_BIT_ENUM",
    "DEFINE_BIT_ENUM_WITH_UNDERLYING_TYPE",
    "DEFINE_ENUM_WITH_UNDERLYING_TYPE",
    "DEFINE_AMBIGUOUS_ENUM_WITH_UNDERLYING_TYPE", "YT_DEFINE_ERROR_ENUM"
]
WhitespaceSensitiveMacros = [
    "MOCK_METHOD",
    "REGISTER_DERIVED_EXTERNALIZED_YSON_STRUCT",
    "PP_STRINGIZE"
]

# Use one space at word boundaries as well as around operators.
DeclarationSpecifierSpacing = Space
DeclarationNameSpacing = Space
ReturnValueSpacing = Space
CoReturnValueSpacing = Space
ThrowOperandSpacing = Space
CoYieldValueSpacing = Space
CoAwaitOperandSpacing = Space
GotoLabelSpacing = Space
CaseValueSpacing = Space
NewTypeSpacing = Space
DeleteOperandSpacing = Space
BaseSpecifierSpacing = Space
TemplateParameterNameSpacing = Space
RecordNameSpacing = Space
EnumKeywordSpacing = Space
EnumNameSpacing = Space
NamespaceNameSpacing = Space
UsingKeywordSpacing = Space
LinkageLanguageSpacing = Space
TemplateKeywordSpacing = Space
TemplateTypeArgumentSpacing = NoSpace
TemplateTypeArgumentInteriorSpacing = NoSpace
NamespaceBraceSpacing = Space
EnumBraceSpacing = Space
ArrayDeclarationSpacing = NoSpace
ArrayDeclarationInteriorSpacing = NoSpace
StructuredBindingBracketSpacing = NoSpace
FunctionSpaceBeforeParameters = NoSpace
SpaceInsideFunctionParameters = NoSpace
EmptyFunctionParametersSpacing = NoSpace
ReturnArrowSpaceBefore = Space
ReturnArrowSpaceAfter = Space
FunctionQualifierSpacing = Space
FunctionRefQualifierSpacing = Space
FunctionCvRefQualifierSpacing = Space
NoexceptSpaceBeforeSpecifier = Space
NoexceptSpaceBeforeParentheses = NoSpace
DecltypeSpaceBeforeParentheses = NoSpace
LambdaSpaceBeforeParameters = Space
LambdaCallSpaceBeforeArguments = Space
LambdaBraceSpacing = Space
SpaceInsideLambdaParameters = NoSpace
SpaceAroundCaptureList = NoSpace
SpaceAroundCaptureAssignment = Space
EmptyLambdaCaptureSpacing = NoSpace
EmptyLambdaParametersSpacing = NoSpace
EmptyLambdaBodySpacing = Space
FunctionCallSpaceBeforeParameters = NoSpace
SpaceInsideCallArguments = NoSpace
EmptyFunctionCallArgumentsSpacing = NoSpace
ControlBlockSpaceBeforeBrace = Space
ControlBlockKeywordSpacing = Space
ControlBlockConditionSpacing = NoSpace
LoopSemicolonSpacing = Space
ConditionInitSemicolonSpacing = Space
RangeBasedForColonSpacing = Space
EmptyBlockInteriorSpacing = Space
BlockInteriorSpacing = Space
StatementSemicolonSpacing = NoSpace
DeclarationSemicolonSpacing = NoSpace
InitializerBracesSpacing = NoSpace
BraceInitializerSpacing = NoSpace
NewArraySpaceBeforeBrackets = NoSpace
ArgumentCommentSpacing = Space
ArgumentNameCommentSpacing = Space

ExpressionsBreak = IfNeeded
ExpressionsPacking = Fill
BinaryOperatorSide = Trailing
ShiftOperatorSide = Leading
AssignmentOperatorSide = Trailing
TernaryOperatorSide = Leading
TernaryLayout = ThreePart
TernaryOperatorIndentation = Align
GroupingInteriorSpacing = NoSpace
CastArgumentSpacing = NoSpace
CastSpacing = NoSpace
CommaSpaceBefore = NoSpace
CommaSpaceAfter = Space
MemberAccessOperatorsSpacing = NoSpace
ScopeResolutionSpacing = NoSpace
UnaryOperatorSpacing = NoSpace
PostfixOperatorSpacing = NoSpace
BinaryOperatorSpacing = Space
AssignmentOperatorSpacing = Space
OperatorOverloadOperatorSpaceBefore = NoSpace
OperatorOverloadOperatorSpaceAfter = NoSpace
SubscriptOperatorSpacing = NoSpace
SubscriptOperatorInteriorSpacing = NoSpace

FunctionDeclarationParameterNames = Required
FunctionDefinitionParameterNames = NameOrCommentedNameRequired
ClassNameCase = PascalCase
ClassNamePrefixes = ["T", "I", "E"]
StructNameCase = PascalCase
StructNamePrefixes = ["T", "I", "E"]
EnumNameCase = PascalCase
EnumNamePrefixes = ["E"]
FunctionNameCase = PascalCase
NamespaceNameCase = PascalCase
NamespaceNamePrefixes = ["N"]
LocalVariableNameCase = camelCase
LocalVariableNameExemptions = ["Logger", "_", "this_"]
ParameterNameCase = camelCase
ParameterNameExemptions = ["Logger", "_", "this_"]
GlobalVariableNameCase = PascalCase
StaticLocalVariableNameCase = PascalCase
PublicMemberVariableNameCase = PascalCase
ProtectedMemberVariableNameCase = PascalCase
ProtectedMemberVariableNameSuffixes = ["_"]
ProtectedMemberVariableNameExemptions = ["Logger"]
PrivateMemberVariableNameCase = PascalCase
PrivateMemberVariableNameSuffixes = ["_"]
PrivateMemberVariableNameExemptions = ["Logger"]
# Static members take precedence over access-specific suffix rules.
StaticMemberVariableNameCase = PascalCase
EnumeratorNameCase = PascalCase
# Explicit vocabulary; unrecognized words and ambiguous boundaries stay unchecked.
# Omit overloaded abbreviations such as CH (ClickHouse / character).
NamingAcronyms = ["IO", "IP", "YT", "TCP", "HTTP", "RPC", "MPSC"]
Exclude = ["(^|/)moody_camel_concurrent_queue\\.h$"]

# Explicit YTsaurus library annotations; syntax lowering owns contextual guards.
# Keep fitting condition/error prefixes and messages inline; format arguments break.
CallLineMessageNames = [
    "THROW_ERROR_EXCEPTION",
    "THROW_ERROR_EXCEPTION_IF",
    "THROW_ERROR_EXCEPTION_UNLESS",
    "TError",
    "YT_LOG_TRACE",
    "YT_LOG_DEBUG",
    "YT_LOG_INFO",
    "YT_LOG_WARNING",
    "YT_LOG_ERROR",
    "YT_LOG_ALERT",
    "YT_LOG_FATAL",
    "YT_LOG_ALERT_AND_THROW",
    "YT_TLOG_TRACE",
    "YT_TLOG_DEBUG",
    "YT_TLOG_INFO",
    "YT_TLOG_WARNING",
    "YT_TLOG_ERROR",
    "YT_TLOG_ALERT",
    "YT_TLOG_FATAL",
    "YT_TLOG_ALERT_AND_THROW",
    "YT_TLOG_EVENT",
    "YT_TLOG_DEBUG_IF",
    "YT_TLOG_FATAL_IF",
    "YT_TLOG_DEBUG_UNLESS",
    "YT_TLOG_EVENT_WITH_STATIC_ANCHOR",
]
# Empty annotations select AllSafe; ordinary chains wrap when they do not fit.
ChainedCallRootNames = []
# Logging/error and YSON builders break even with one suffix call.
# This is independent of their message and format-argument layout.
AlwaysBreakChainRootNames = [
    "THROW_ERROR_EXCEPTION",
    "THROW_ERROR_EXCEPTION_IF",
    "THROW_ERROR_EXCEPTION_UNLESS",
    "YT_LOG_TRACE",
    "YT_LOG_DEBUG",
    "YT_LOG_INFO",
    "YT_LOG_WARNING",
    "YT_LOG_ERROR",
    "YT_LOG_ALERT",
    "YT_LOG_FATAL",
    "YT_LOG_ALERT_AND_THROW",
    "YT_TLOG_TRACE",
    "YT_TLOG_DEBUG",
    "YT_TLOG_INFO",
    "YT_TLOG_WARNING",
    "YT_TLOG_ERROR",
    "YT_TLOG_ALERT",
    "YT_TLOG_FATAL",
    "YT_TLOG_ALERT_AND_THROW",
    "YT_TLOG_EVENT",
    "YT_TLOG_DEBUG_IF",
    "YT_TLOG_FATAL_IF",
    "YT_TLOG_DEBUG_UNLESS",
    "YT_TLOG_EVENT_WITH_STATIC_ANCHOR",
    "TError",
    "BuildYsonFluently",
    "BuildYsonNodeFluently",
    "BuildYsonStringFluently",
    "NYTree::BuildYsonFluently",
    "NYTree::BuildYsonNodeFluently",
    "NYT::NYTree::BuildYsonFluently",
    # Registrar is the same library-role convention used by sticky pairs below.
    "registrar",
]
# These calls always start a new line, independently of the chain's root.
# Via/AsyncVia/Run and WithTag/WithTags may remain inline when they fit.
AlwaysBreakChainCallNames = ["ThrowOnError", "ValueOrThrow"]
# Fluent YSON scopes nest; an item selector stays beside its value builder.
IndentedChainScopePairs = [
    "BeginList:EndList",
    "BeginMap:EndMap",
    "BeginAttributes:EndAttributes",
]
StickyChainCallPairs = [
    "Item:Value",
    "Item:BeginList",
    "Item:BeginMap",
    "Item:BeginAttributes",
    "Item:Do",
    "Item:DoList",
    "Item:DoMap",
    "Item:DoListFor",
    "Item:DoMapFor",
    "Item:Entity",
    "registrar:Parameter",
    "registrar:ExternalClassParameter",
]
IndentedCallScopePairs = [
    "OnBeginList:OnEndList",
    "OnBeginMap:OnEndMap",
    "OnBeginAttributes:OnEndAttributes",
]
