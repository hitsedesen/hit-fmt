# Approximation of the Google C++ style / clang-format's Google preset.
# Use with --config, or copy to .hit-fmt in a source tree.
# See ../CONFIGURATION.md for unsupported rules and observed limitations.
IndentWidth = 2
ColumnLimit = 80
IndentationKind = Spaces
PreprocessorIndentation = LineStart
TrailingWhitespace = Trim
PointerReferenceLocation = Left

IndentMembers = Indent
# Keep existing statement indentation: the current reindenter misplaces
# statements in inline member functions (see the Google corpus notes).
IndentBlockBodies = false
IndentCaseLabels = Indent
StatementAttributeIndent = Block
ClassBracePlacement = Attach
StructBracePlacement = Attach
UnionBracePlacement = Attach
FunctionBracePlacement = Attach
LambdaBracePlacement = Attach
NamespaceBracePlacement = Attach
ClassBraceSpacing = SingleSpace
StructBraceSpacing = SingleSpace
UnionBraceSpacing = SingleSpace
EnumBraceSpacing = SingleSpace
FunctionBraceSpacing = SingleSpace
LambdaBraceSpacing = SingleSpace
NamespaceBraceSpacing = SingleSpace
ControlBlockBracePlacement = SameLine
ControlBlockSpaceBeforeBrace = Space
ControlBlockKeywordSpacing = Space
# Required rewrites Google's two-space closing comments as one-space
# comments and replaces descriptive anonymous-namespace comments.
NamespaceComments = Preserve

FunctionParameterSplit = Pack
FirstFunctionParameterPosition = NameLineIfFits
FunctionParameterIndent = Continuation
FunctionParameterNewLineIndent = 4
MergeFunctionParameters = true
ExpressionLayoutCondition = Overflow
ControlConditionIndent = Continuation
BinaryOperatorPlacement = Trailing
AssignmentOperatorPlacement = Trailing
TernaryOperatorPlacement = Leading
TernarySplit = AsNeeded
CallArgumentSplit = Pack
FirstCallArgumentPosition = CallLine
CallArgumentIndent = Continuation
# Nested aggregate braces may be misclassified and reflowed incorrectly.
InitializerListSplit = Preserve

FunctionSpaceBeforeParameters = NoSpace
FunctionCallSpaceBeforeParameters = NoSpace
SpaceInsideFunctionParameters = NoSpace
SpaceInsideCallArguments = NoSpace
LambdaSpaceBeforeParameters = NoSpace
SpaceInsideLambdaParameters = NoSpace
SpaceAroundCaptureList = NoSpace
SpaceAroundCaptureAssignment = Space
EmptyLambdaCaptureSpacing = NoSpace
EmptyLambdaParametersSpacing = NoSpace
EmptyFunctionParametersSpacing = NoSpace
EmptyFunctionCallArgumentsSpacing = NoSpace
EmptyBlockInteriorSpacing = NoSpace
EmptyBraceInitializerInteriorSpacing = NoSpace
BlockInteriorSpacing = Space
InitializerBracesSpacing = NoSpace
# Preserve the gap before braced initializers: NoSpace also removes the
# required gap in some macro-annotated record declarations.
BraceInitializerSpacing = Preserve
ControlBlockConditionSpacing = NoSpace
GroupingInteriorSpacing = NoSpace
CastArgumentSpacing = NoSpace
CastSpacing = NoSpace
CommaSpacing = After
StatementSemicolonSpacing = NoSpace
DeclarationSemicolonSpacing = NoSpace
# NoSpace can merge an export macro with a leading :: qualified type.
MemberAccessOperatorsSpacing = Preserve
UnaryOperatorSpacing = NoSpace
PostfixOperatorSpacing = NoSpace
# Space collapses manually aligned multiline conditional columns.
TernaryOperatorSpacing = Preserve
# Space can introduce whitespace before a comma after a template-id.
BinaryOperatorSpacing = Preserve
AssignmentOperatorSpacing = Space
ReturnArrowSpacing = LeftAndRight
TemplateKeywordSpacing = Space
TemplateTypeArgumentSpacing = NoSpace
TemplateTypeArgumentInteriorSpacing = NoSpace
SubscriptOperatorSpacing = NoSpace
SubscriptOperatorInteriorSpacing = NoSpace
ArrayDeclarationSpacing = NoSpace
ArrayDeclarationInteriorSpacing = NoSpace
StructuredBindingBracketSpacing = NoSpace
LoopSemicolonSpacing = Space
ConditionInitSemicolonSpacing = Space
RangeBasedForColonSpacing = Space
FunctionQualifierSpacing = Space
NoexceptSpaceBeforeSpecifier = Space
NoexceptSpaceBeforeParentheses = NoSpace

# Google uses a one-space access-label offset with two-space members;
# neither NoIndent nor Indent can express that. Preserve existing labels.
IndentAccessModifiers = Preserve
# Google include categories, main-header precedence and regrouping cannot
# be expressed by Sort's simple quoted-before-angled lexicographic order.
IncludeOrder = Preserve
# Leave context-sensitive base and constructor lists source-owned.
InheritanceList = Preserve
ConstructorInitializerList = Preserve
# Google naming depends on role (e.g. kConstant vs variable vs field);
# the available per-kind checks cannot distinguish these roles.
