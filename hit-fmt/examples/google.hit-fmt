# Google-inspired approximation, not clang-format compatibility.
# Fitting canonical lists flatten; manual columns require explicit preservation.
# Directives remain byte-exact, rather than rewriting preprocessor indentation.
Layout = Canonical
IndentWidth = 2
ColumnLimit = 80
WidthDiagnostics = Report
IndentationKind = Spaces
LineEnding = LF
TrailingWhitespace = Trim
ListBreak = IfNeeded
ListPacking = Fill
ListFirstItem = InlineIfFits
ListCloser = SameLine
ListAlignment = Delimiter
ContinuationOffset = 4
AlignmentFallbackOffset = 4
# Template parameters and arguments pack and align like calls.
TemplateParametersLayout = Canonical
TemplateParametersBreak = IfNeeded
TemplateParametersPacking = Fill
TemplateParametersFirstItem = InlineIfFits
TemplateParametersCloser = SameLine
TemplateParametersAlignment = Delimiter
TemplateParametersContinuationOffset = 4
TemplateParametersAlignmentFallbackOffset = 4
# Argument overrides also apply to named-cast type brackets.
TemplateArgumentsLayout = Canonical
TemplateArgumentsBreak = IfNeeded
TemplateArgumentsPacking = Fill
TemplateArgumentsFirstItem = InlineIfFits
TemplateArgumentsCloser = SameLine
TemplateArgumentsAlignment = Delimiter
TemplateArgumentsContinuationOffset = 4
TemplateArgumentsAlignmentFallbackOffset = 4
BaseListsLayout = Canonical
BaseListsFirstItem = NextLine
BaseListsColonSide = Leading
BaseListsCommaSide = Trailing
BaseListsColonSpaceBefore = Space
BaseListsColonSpaceAfter = Space
ConstructorListsLayout = Canonical
ConstructorListsPacking = VerticalWhenBroken
ConstructorListsFirstItem = NextLine
ConstructorListsColonSide = Leading
ConstructorListsCommaSide = Trailing
ConstructorListsColonSpaceBefore = Space
ConstructorListsColonSpaceAfter = Space
BodyShape = CompactIfFits
EmptyBodyShape = CompactIfFits
PointerReferenceDeclaratorLocation = Left
IndentAccessModifiers = Indent
AccessModifierIndentWidth = 1
IndentMembers = Indent
IndentNamespaces = NoIndent
IndentCaseLabels = Indent
StatementAttributeIndent = Block
# Google uses semantic categories, not directory-depth groups. Keep the
# existing C, C++, third-party and project boundaries; sort within each.
# https://google.github.io/styleguide/cppguide.html#Names_and_Order_of_Includes
# Rules are inactive under Preserve. Pass project-relative input filenames.
IncludeOrder = Sort
IncludeMatchingHeader = First
IncludeGrouping = Preserve
IncludeGroups = []
IncludeDirectoryOrder = NearestFirst
IncludePathBase = ProjectRoot
IncludeStandardHeaders = Last
# Ordinary trailing // gaps; comment alignment and prose wrapping are not modeled.
TrailingCommentSpaces = 2
NamespaceComments = AddMissing
NamespaceCommentSpaces = 2
ShortNamespaceLines = 1
RemoveNullDeclarations = true
InitializersTrailingComma = Preserve
InitializersCloser = SameLine

TemplateKeywordSpacing = Space
TemplateTypeArgumentSpacing = NoSpace
TemplateTypeArgumentInteriorSpacing = NoSpace
ClassBraceSpacing = Space
StructBraceSpacing = Space
UnionBraceSpacing = Space
EnumBraceSpacing = Space
FunctionBraceSpacing = Space
LambdaBraceSpacing = Space
NamespaceBraceSpacing = Space
ArrayDeclarationSpacing = NoSpace
ArrayDeclarationInteriorSpacing = NoSpace
StructuredBindingBracketSpacing = NoSpace
FunctionSpaceBeforeParameters = NoSpace
SpaceInsideFunctionParameters = NoSpace
EmptyFunctionParametersSpacing = NoSpace
ReturnArrowSpaceBefore = Space
ReturnArrowSpaceAfter = Space
FunctionQualifierSpacing = Space
NoexceptSpaceBeforeSpecifier = Space
NoexceptSpaceBeforeParentheses = NoSpace
LambdaSpaceBeforeParameters = NoSpace
SpaceInsideLambdaParameters = NoSpace
SpaceAroundCaptureList = NoSpace
SpaceAroundCaptureAssignment = Space
EmptyLambdaCaptureSpacing = NoSpace
EmptyLambdaParametersSpacing = NoSpace
FunctionCallSpaceBeforeParameters = NoSpace
SpaceInsideCallArguments = NoSpace
EmptyFunctionCallArgumentsSpacing = NoSpace
ControlBlockSpaceBeforeBrace = Space
ControlBlockKeywordSpacing = Space
ControlBlockConditionSpacing = NoSpace
LoopSemicolonSpacing = Space
ConditionInitSemicolonSpacing = Space
RangeBasedForColonSpacing = Space
EmptyBlockInteriorSpacing = NoSpace
BlockInteriorSpacing = Space
StatementSemicolonSpacing = NoSpace
DeclarationSemicolonSpacing = NoSpace
EmptyBraceInitializerInteriorSpacing = NoSpace
InitializerBracesSpacing = NoSpace
BraceInitializerSpacing = NoSpace
NewArraySpaceBeforeBrackets = NoSpace

ExpressionsBreak = IfNeeded
ExpressionsPacking = Fill
BinaryOperatorSide = Trailing
AssignmentOperatorSide = Trailing
TernaryOperatorSide = Leading
TernaryLayout = Flexible
GroupingInteriorSpacing = NoSpace
CastArgumentSpacing = NoSpace
CastSpacing = NoSpace
CommaSpaceBefore = NoSpace
CommaSpaceAfter = Space
MemberAccessOperatorsSpacing = NoSpace
# Export macros before :: cannot be resolved without preprocessing/name lookup.
ScopeResolutionSpacing = Preserve
UnaryOperatorSpacing = NoSpace
PostfixOperatorSpacing = NoSpace
TernaryOperatorSpacing = Space
BinaryOperatorSpacing = Space
AssignmentOperatorSpacing = Space
SubscriptOperatorSpacing = NoSpace
SubscriptOperatorInteriorSpacing = NoSpace
# Role-sensitive naming rules (constants vs fields etc.) are out of scope.
