# Preserve source break topology by default. Set Layout = Canonical
# to normalize groups. Category Inherit values resolve once.
# Generated* applies to properties rebuilt by their owning canonical
# combinator (also inserted gaps), not unrelated nested edits.
# Break = Always requires a legal owned break; Preserve/protection win.
# EmptyBodyShape is independent of nonempty BodyShape.
# Blank counts measure empty lines; zero retains boundary topology.
# Exact or minimum counts above an explicit MaxEmptyLines cap are invalid.
# Minimum:N requires at least N empty lines; caps still limit retained gaps.
# IncludeDelimiters = Preserve (default) keeps existing quotes/angles.
# QuotedLocal quotes explicit ./ and ../ paths and lexically same-directory
# paths; it angles other paths using IncludePathBase and the input filename.
# It never changes paths.
# Bare names keep their delimiters: local and system names are ambiguous.
# For example, <../sibling/header.h> becomes "../sibling/header.h".
# Works independently of IncludeOrder, also on single/commented includes.
# Macro includes, splices and protected directives stay exact.
# IncludeOrder = Sort enables the following sorting policies.
# IncludeCategoryOrder = QuotedFirst (default) puts quoted before angled;
# AngledFirst reverses them. IncludeMatchingHeader = First stays first;
# IncludeStandardHeaders = Last keeps unclaimed standard headers last.
# IncludeMatchingHeader = First selects quoted same-stem headers
# (.h/.hh/.hpp/.hxx/.h++) in the input file's directory.
# Pairing is disabled for header inputs or missing filenames.
# IncludeGrouping = Preserve retains existing blank boundaries;
# Regroup groups by IncludeGroups rules; Directory additionally
# subdivides each rule by its directory suffix and Depth.
# Example: IncludeGroups = [{Prefix = "library/", Depth = 1}]
# Each rule has Prefix or Prefixes, StandardHeaders = true, or both;
# Depth and Priority are optional. Nonempty entries ending in / match
# directory prefixes; other entries match exact header names, quoted or angled.
# Entries must be unique normalized relative paths.
# Depth defaults to 127; Priority defaults to 0.
# Priority is an integer from -128 to 127.
# Lower values sort first within each quote/angle category.
# Unmatched headers have priority zero.
# Priority never changes first-match selection; equal priorities
# use IncludeGroupOrder and the usual directory/header ordering.
# Depth 0 keeps the entire rule together within quote/angle groups;
# 127 uses the full remaining directory, not the filename.
# Values 1..126 cap components after the matched prefix.
# Depth must be an integer from 0 to 127; negatives are invalid.
# With prefix library/, 1 groups library/core/a.hpp and
# library/core/detail/b.hpp together; 2 separates them.
# Prefixes = ["yt/yt/", "yt/yt_proto/yt/"] merges corresponding
# suffix groups; the first entry's directory represents their ordering path.
# Exact-name aliases use containing directories, excluding filenames.
# First matching rule/prefix wins. IncludeGroupOrder = Directory
# (default) orders equal-priority groups together by directory.
# Configured uses list order within each priority tier, then
# IncludeDirectoryOrder for subgroups within each rule.
# Unmatched paths follow configured rules in the same tier.
# Prefixes within one rule are aliases, not separate priorities.
# StandardHeaders = true selects the same angled names as
# IncludeStandardHeaders = Last, but uses ordinary group ordering.
# A matched standard group overrides Last, ignores Depth and stays
# alphabetical. At most one standard rule is allowed. Prefix or Prefixes
# adds headers to it, for example Prefixes = ["stdio.h", "stdint.h"].
# Put it before an empty-prefix fallback.
# Example: project headers, then standard headers, then unknown/system headers:
# IncludeGroups = [
#     {Prefix = "project/", Priority = 0},
#     {StandardHeaders = true, Prefixes = ["stdio.h", "stdint.h"], Priority = 1},
#     {Prefix = "", Priority = 2}
# ]
# <stdio.h> and <vector> precede <unknown_project/header.h> and <Windows.h>.
# To put standard headers first, give their rule Priority = -1.
# Example: IncludeGroupOrder = Configured with IncludeGroups =
# [{Prefix = "library/", Depth = 1}, {Prefix = "util/", Depth = 1}]
# puts library/ first, then util/, with nearest subgroups and
# alphabetical include paths inside each subgroup by default.
# Unmatched paths use full-directory groups under Directory.
# Prefix = "" is an explicit fallback for any include spelling;
# its Depth counts from the start of the resolved directory.
# Example: nearest project groups, then library/, then util/:
# IncludeGroupOrder = Directory
# IncludePathBase = ProjectRoot
# IncludeGroups = [
#     {Prefix = "library/", Priority = 1},
#     {Prefix = "util/", Priority = 2},
#     {Prefix = "", Depth = 3}
# ]
# Specific rules precede the fallback for matching, not output.
# Preserve ignores rules, priorities and IncludeGroupOrder.
# Regroup ignores Depth; unmatched headers follow configured
# groups in the same priority tier. Paired/standard groups stay
# separate. Include paths are never rewritten by group aliases.
# Regroup/Directory span blank lines and insert one empty line
# between groups; both conflict with MaxEmptyLines = 0.
# IncludeDirectoryOrder = NearestFirst uses parent + child steps
# from the input directory; ties sort by directory spelling.
# Alphabetical omits distance. IncludeCategoryOrder orders quote/angle groups.
# IncludeInGroupOrder = Alphabetical retains in-group ordering.
# NearestFirst uses full resolved containing-directory distance,
# then alphabetical include spelling, without changing groups.
# Depth and aliases affect group keys, not in-group distance.
# This also works within adjacent blocks under Preserve.
# Paired and standard-header groups remain alphabetical.
# IncludePathBase = SourceDirectory resolves source-relative paths.
# ProjectRoot uses the working directory as the input path root.
# Absolute input filenames beneath it are rebased to that root.
# Bare quoted names and quoted ./ or ../ paths stay source-relative.
# Paths normalize lexically only; no file lookup or spelling edit.
# IncludeStandardHeaders = Last uses a lexical heuristic: angled
# names containing neither / nor .h go in a final alphabetical group,
# unless claimed by an explicit StandardHeaders = true rule.
# It is case-sensitive, not ISO detection: extensionless vendor
# names qualify; quoted names and stdio.h do not qualify automatically.
# Add stdio.h to a StandardHeaders rule via Prefix or Prefixes when needed.
# Preserve keeps ordinary sorting. The final group follows even unmatched headers.
# Check mode reports one include-order failure per file, not per header.
# Other formatting, naming and width failures remain independent.
# Rules are validated even when inactive; prefixes must be unique.
# Comments, macros, conditionals, protection and mixed line endings
# stop blocks. Hunk edits require authority over the entire block.
# LineEnding Preserve uses the first newline for generated endings
# and retains copied gap bytes, not uniform per-edge preservation.
# LF/CRLF spell only authorized whole whitespace newline atoms;
# no final newline insertion, token/directive conversion or cleanup.
# Protected regions remain byte-exact. Directive whitespace is opt-in.
# Option guidance: --help-config

# Formatting options

# Values: Preserve | Canonical
Layout = Preserve

# Values: 1..32
IndentWidth = 4

# Values: 0 (unlimited) or 1..10000
ColumnLimit = 120

# Values: Off | Report
WidthDiagnostics = Off

# Values: false | true
HonorClangFormatDirectives = true

# Values: Preserve | Spaces | Tabs
IndentationKind = Preserve

# Values: Preserve | LF | CRLF
LineEnding = Preserve

# Values: Preserve | Trim
TrailingWhitespace = Preserve

# Values: IfNeeded | Always
ListBreak = IfNeeded

# AllOrVertical keeps all items in one row when they fit,
# otherwise splits every separator. FirstItem and Closer
# still control the independent delimiter boundaries.
# Example: CallsPacking = AllOrVertical, ColumnLimit = 32,
# CallsFirstItem = NextLine, CallsCloser = OwnLine:
# ProcessPendingTasks(
#     first, second
# );
# Block comments after a separator move with the next item.
# Line comments and mixed comment prefixes stay in place.
# In a broken call: consume(alpha,
#     /* next argument */ beta);
# Values: Fill | VerticalWhenBroken | AllOrVertical
ListPacking = Fill

# Values: InlineIfFits | NextLine
ListFirstItem = InlineIfFits

# Values: SameLine | OwnLine
ListCloser = SameLine

# Values: Block | Delimiter
ListAlignment = Block

# Values: 0 (use IndentWidth) or 1..32
ContinuationOffset = 0

# Values: 0 (use IndentWidth) or 1..32
AlignmentFallbackOffset = 0

# Format adjacent string fragments with Calls rules as one expression.
# Uses CallsFirstItem for sole fragmented strings and breaks initializers
# below the assignment operator when their fragment group breaks.
# false preserves the existing Expressions formatting rules.
StringLiteralFragmentsAsArguments = false

# Keep authored multiline constructs multiline while choosing canonical
# break positions and indentation. Inline constructs may still wrap.
# Explicit brace placement and Preserve/protected layout take precedence.
KeepMultiline = false

# Values: Inherit | Preserve | Canonical
CallsLayout = Inherit

# Values: Inherit | IfNeeded | Always
CallsBreak = Inherit

# Values: Inherit | Fill | VerticalWhenBroken | AllOrVertical
CallsPacking = Inherit

# Values: Inherit | InlineIfFits | NextLine
CallsFirstItem = Inherit

# Values: Inherit | Block | Delimiter
CallsAlignment = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
CallsContinuationOffset = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
CallsAlignmentFallbackOffset = Inherit

# Values: Inherit | SameLine | OwnLine
CallsCloser = Inherit

# Values: Inherit | InlineIfFits | NextLine
CallsSoleArgumentFirstItem = Inherit

# In canonical calls, attach a direct sole lambda to both parentheses:
# Call([] {
#     Work();
# });
# Overrides CallsBreak, CallsFirstItem, CallsSoleArgumentFirstItem and
# CallsCloser. Lambda header/body rules and protected comments still apply.
# KeepMultiline does not split these attached call boundaries.
# false uses ordinary call rules. Values: false | true
CallsSoleLambdaArgumentInline = false

# Values: Inherit | Preserve | Canonical
ParametersLayout = Inherit

# Values: Inherit | IfNeeded | Always
ParametersBreak = Inherit

# Values: Inherit | Fill | VerticalWhenBroken | AllOrVertical
ParametersPacking = Inherit

# Values: Inherit | InlineIfFits | NextLine
ParametersFirstItem = Inherit

# Values: Inherit | Block | Delimiter
ParametersAlignment = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
ParametersContinuationOffset = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
ParametersAlignmentFallbackOffset = Inherit

# Values: Inherit | SameLine | OwnLine
ParametersCloser = Inherit

# Values: Inherit | Preserve | Canonical
TemplateParametersLayout = Inherit

# Values: Inherit | IfNeeded | Always
TemplateParametersBreak = Inherit

# Values: Inherit | Fill | VerticalWhenBroken | AllOrVertical
TemplateParametersPacking = Inherit

# Values: Inherit | InlineIfFits | NextLine
TemplateParametersFirstItem = Inherit

# Values: Inherit | Block | Delimiter
TemplateParametersAlignment = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
TemplateParametersContinuationOffset = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
TemplateParametersAlignmentFallbackOffset = Inherit

# Values: Inherit | SameLine | OwnLine
TemplateParametersCloser = Inherit

# Values: Inherit | Preserve | Canonical
TemplateArgumentsLayout = Inherit

# Values: Inherit | IfNeeded | Always
TemplateArgumentsBreak = Inherit

# Values: Inherit | Fill | VerticalWhenBroken | AllOrVertical
TemplateArgumentsPacking = Inherit

# Values: Inherit | InlineIfFits | NextLine
TemplateArgumentsFirstItem = Inherit

# Values: Inherit | Block | Delimiter
TemplateArgumentsAlignment = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
TemplateArgumentsContinuationOffset = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
TemplateArgumentsAlignmentFallbackOffset = Inherit

# Values: Inherit | SameLine | OwnLine
TemplateArgumentsCloser = Inherit

# Values: Inherit | Preserve | Canonical
InitializersLayout = Inherit

# Values: Inherit | IfNeeded | Always
InitializersBreak = Inherit

# Values: Inherit | Fill | VerticalWhenBroken | AllOrVertical
InitializersPacking = Inherit

# Values: Inherit | InlineIfFits | NextLine
InitializersFirstItem = Inherit

# Values: Inherit | Block | Delimiter
InitializersAlignment = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
InitializersContinuationOffset = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
InitializersAlignmentFallbackOffset = Inherit

# Values: Inherit | SameLine | OwnLine
InitializersCloser = Inherit

# Values: Inherit | Preserve | Canonical
CapturesLayout = Inherit

# Values: Inherit | IfNeeded | Always
CapturesBreak = Inherit

# Values: Inherit | Fill | VerticalWhenBroken | AllOrVertical
CapturesPacking = Inherit

# Values: Inherit | InlineIfFits | NextLine
CapturesFirstItem = Inherit

# Values: Inherit | Block | Delimiter
CapturesAlignment = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
CapturesContinuationOffset = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
CapturesAlignmentFallbackOffset = Inherit

# Values: Inherit | SameLine | OwnLine
CapturesCloser = Inherit

# Values: Inherit | Preserve | Canonical
ControlHeadersLayout = Inherit

# Values: Inherit | IfNeeded | Always
ControlHeadersBreak = Inherit

# Values: Inherit | Fill | VerticalWhenBroken | AllOrVertical
ControlHeadersPacking = Inherit

# In broken headers: InlineIfFits keeps the first condition
# beside the opener if it fits; NextLine moves it below.
# Values: Inherit | InlineIfFits | NextLine
ControlHeadersFirstItem = Inherit

# Values: Inherit | Block | Delimiter
ControlHeadersAlignment = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
ControlHeadersContinuationOffset = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
ControlHeadersAlignmentFallbackOffset = Inherit

# Values: Inherit | SameLine | OwnLine
ControlHeadersCloser = Inherit

# AllOrVertical behaves like VerticalWhenBroken here.
# Fill keeps ordinary expression packing (default).
# VerticalWhenBroken splits all top-level &&/|| operands
# when an if header wraps, including nested call breaks.
# Parentheses, init-statements and other controls keep
# their own policies. Canonical header/expression layout
# is required; fitting headers stay flat unless forced.
# Comment attachments and protected gaps take precedence.
# BinaryOperatorSide selects leading/trailing operators.
# ControlHeadersFirstItem selects InlineIfFits/NextLine.
# Example with Leading: if (ready
#     && (left || right)
#     && enabled)
# Values: Fill | VerticalWhenBroken | AllOrVertical
IfConditionsPacking = Fill

# Values: Inherit | Preserve | Canonical
EnumeratorsLayout = Inherit

# Values: Inherit | IfNeeded | Always
EnumeratorsBreak = Inherit

# Values: Inherit | Fill | VerticalWhenBroken | AllOrVertical
EnumeratorsPacking = Inherit

# Values: Inherit | InlineIfFits | NextLine
EnumeratorsFirstItem = Inherit

# Values: Inherit | Block | Delimiter
EnumeratorsAlignment = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
EnumeratorsContinuationOffset = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
EnumeratorsAlignmentFallbackOffset = Inherit

# Values: Inherit | SameLine | OwnLine
EnumeratorsCloser = Inherit

# Values: Inherit | Preserve | Canonical
BaseListsLayout = Inherit

# Values: Inherit | IfNeeded | Always
BaseListsBreak = Inherit

# Values: Inherit | Fill | VerticalWhenBroken | AllOrVertical
BaseListsPacking = Inherit

# Values: Inherit | InlineIfFits | NextLine
BaseListsFirstItem = Inherit

# Values: Inherit | Block | Delimiter
BaseListsAlignment = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
BaseListsContinuationOffset = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
BaseListsAlignmentFallbackOffset = Inherit

# Values: Inherit | Preserve | Canonical
ConstructorListsLayout = Inherit

# Values: Inherit | IfNeeded | Always
ConstructorListsBreak = Inherit

# Values: Inherit | Fill | VerticalWhenBroken | AllOrVertical
ConstructorListsPacking = Inherit

# Values: Inherit | InlineIfFits | NextLine
ConstructorListsFirstItem = Inherit

# Values: Inherit | Block | Delimiter
ConstructorListsAlignment = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
ConstructorListsContinuationOffset = Inherit

# Values: Inherit | 0 (use IndentWidth) or 1..32
ConstructorListsAlignmentFallbackOffset = Inherit

# Values: IfNeeded | Always
ExpressionsBreak = IfNeeded

# AllOrVertical behaves like VerticalWhenBroken here.
# Values: Fill | VerticalWhenBroken | AllOrVertical
ExpressionsPacking = Fill

# Inherit (default) follows ExpressionsPacking.
# Applies to assignment operators and = initializers,
# including parameter defaults and enumerator values.
# Fill can keep the RHS prefix beside the assignment
# while nested expressions wrap independently.
# VerticalWhenBroken splits every assignment boundary
# in a broken assignment sequence.
# AssignmentRhsPlacement = NextLine and ExpressionsBreak
# = Always still require assignment breaks. Example:
# ExpressionsPacking = VerticalWhenBroken
# AssignmentsPacking = Fill
# auto ready = firstCheck() ||
#     secondCheck();
# AllOrVertical behaves like VerticalWhenBroken here.
# Values: Inherit | Fill | VerticalWhenBroken | AllOrVertical
AssignmentsPacking = Inherit

# Values: Block | Operand
ExpressionsAlignment = Block

# Values: Inherit | Preserve | Canonical
ExpressionsLayout = Inherit

# Values: Leading | Trailing
BinaryOperatorSide = Trailing

# Values: Leading | Trailing
AssignmentOperatorSide = Trailing

# Values: Leading | Trailing
ShiftOperatorSide = Trailing

# Values: Leading | Trailing
TernaryOperatorSide = Leading

# Values: Flexible | ThreePart
TernaryLayout = Flexible

# Values: Align | Indent
TernaryOperatorIndentation = Align

# Values: Inherit | Preserve | Canonical
ChainsLayout = Inherit

# In control headers, chains break only when needed.
# Even with Always, prefer non-chain breaks.
# Lambda bodies keep their ordinary chain policy.
# AlwaysBreakChainRootNames and AlwaysBreakChainCallNames
# still require their configured breaks in control headers.
# Values: IfNeeded | Always
ChainsBreak = IfNeeded

# AllOrVertical keeps the complete tail after the receiver
# on one continuation line, or splits every tail link.
# Example with ColumnLimit = 40:
# auto client = MakeServiceClient()
#     .Configure(mode).Start();
# Values: Fill | VerticalWhenBroken | AllOrVertical
ChainsPacking = Fill

# Values: Block | Delimiter
ChainsAlignment = Block

# Values: Inherit | Preserve | Canonical
DeclarationHeadersLayout = Inherit

# Values: false | true
BreakAfterTemplateHeader = false

# Canonical DeclarationHeadersLayout only. Preserve keeps clause placement.
# OwnLine separates both sides; OwnLineWithBrace may attach a function brace.
# WithPreceding/WithFollowing prefer the adjacent header; SingleLine prefers both.
# Explicit brace placement and protected/comment boundaries take precedence.
# Values: Preserve | OwnLine | OwnLineWithBrace | WithPreceding | WithFollowing | SingleLine
RequiresClausePosition = Preserve

# Adds IndentWidth for OwnLine, OwnLineWithBrace and WithFollowing.
# Other explicit positions use the ordinary continuation offset when wrapped.
# Values: false | true
IndentRequiresClause = true

# Values: InlineIfFits | NextLine
AssignmentRhsPlacement = InlineIfFits

# Values: Inherit | Preserve | Canonical
BodiesLayout = Inherit

# CompactSingleStatementIfFits: one simple statement, including
# a local declaration, only when it fits ColumnLimit.
# Nested controls/blocks, records, namespaces and sibling
# comments/directives remain expanded. Canonical bodies only.
# Empty bodies use the independent empty-body shape.
# Example: int Next(int x) { return x + 1; }
# Clear(); Notify(); in one body remains multiline.
# Values: Expanded | CompactIfFits | CompactSingleStatementIfFits
BodyShape = Expanded

# Nonempty function bodies, including constructors, destructors and
# configured function-body macros. Inherit uses BodyShape.
# Values: Inherit | Expanded | CompactIfFits | CompactSingleStatementIfFits
FunctionBodyShape = Inherit

# Nonempty control bodies, braced or unbraced, including try/catch
# and case blocks. Standalone blocks keep BodyShape.
# Inherit uses BodyShape; independent of FunctionBodyShape.
# Values: Inherit | Expanded | CompactIfFits | CompactSingleStatementIfFits
ControlBodyShape = Inherit

# CompactSingleStatementIfFits expands empty bodies.
# Values: Expanded | CompactIfFits | CompactSingleStatementIfFits
EmptyBodyShape = Expanded

# Values: Inherit | Preserve | Canonical
LambdaBodiesLayout = Inherit

# Inherit uses BodyShape, independently of FunctionBodyShape and
# ControlBodyShape.
# CompactSingleStatementIfFits: one simple statement, including
# a local declaration, only when it fits ColumnLimit.
# Nested controls/blocks, records, namespaces and sibling
# comments/directives remain expanded. Canonical bodies only.
# Empty bodies use the independent empty-body shape.
# Example: int Next(int x) { return x + 1; }
# Clear(); Notify(); in one body remains multiline.
# Values: Inherit | Expanded | CompactIfFits | CompactSingleStatementIfFits
LambdaBodyShape = Inherit

# CompactSingleStatementIfFits expands empty bodies.
# Values: Inherit | Expanded | CompactIfFits | CompactSingleStatementIfFits
LambdaEmptyBodyShape = Inherit

# Values: Attached | NextLine | NextLineIfHeaderBroken | NextLineIfHeaderIndented
ClassBracePlacement = Attached

# Values: Attached | NextLine | NextLineIfHeaderBroken | NextLineIfHeaderIndented
StructBracePlacement = Attached

# Values: Attached | NextLine | NextLineIfHeaderBroken | NextLineIfHeaderIndented
UnionBracePlacement = Attached

# For all brace placements, NextLineIfHeaderIndented uses
# the last output header line in canonical header layout.
# Break before { at or beyond body indentation; otherwise
# attach it, including after a closing ) at brace indentation.
# Example: void Process(
#     Request request
# ) {
# ConstructorBracePlacement = Inherit follows this rule:
# Worker::Worker() :
#     Cache_(CreateCache())
# {
# Values: Attached | NextLine | NextLineIfHeaderBroken | NextLineIfHeaderIndented
FunctionBracePlacement = Attached

# Values: Inherit | Attached | NextLine | NextLineIfHeaderBroken | NextLineIfHeaderIndented
ConstructorBracePlacement = Inherit

# Values: Inherit | Attached | NextLine | NextLineIfHeaderBroken | NextLineIfHeaderIndented
DestructorBracePlacement = Inherit

# Values: Attached | NextLine | NextLineIfHeaderBroken | NextLineIfHeaderIndented
LambdaBracePlacement = Attached

# Values: Attached | NextLine | NextLineIfHeaderBroken | NextLineIfHeaderIndented
NamespaceBracePlacement = Attached

# Values: Attached | NextLine | NextLineIfHeaderBroken | NextLineIfHeaderIndented
ControlBracePlacement = Attached

# Values: Attached | NextLine | NextLineIfHeaderBroken | NextLineIfHeaderIndented
EnumBracePlacement = Attached

# Applies when a case contains only one compound block.
# Mixed cases align all statements and standalone blocks.
# Example: case 1: { work(); break; } uses this placement;
# In case 2: { work(); } break;, braces align with break.
# Values: Attached | NextLine | NextLineIfHeaderBroken | NextLineIfHeaderIndented
CaseBlockBracePlacement = Attached

# Values: Leading | Trailing
BaseListsColonSide = Leading

# Values: Leading | Trailing
BaseListsCommaSide = Leading

# Values: Leading | Trailing
ConstructorListsColonSide = Leading

# Values: Leading | Trailing
ConstructorListsCommaSide = Leading

# Values: Preserve | Never | WhenMultiline
InitializersTrailingComma = Preserve

# Values: Preserve | Left | Middle | Right
PointerReferenceDeclaratorLocation = Preserve

# Values: Preserve | Indent | NoIndent
IndentAccessModifiers = Preserve

# Values: 0 (use IndentWidth) or 1..32
AccessModifierIndentWidth = 0

# Values: Preserve | Indent | NoIndent
IndentMembers = Preserve

# Values: 0 (use IndentWidth) or 1..32
MemberIndentWidth = 0

# Values: Preserve | Indent | NoIndent
IndentCaseLabels = Preserve

# Values: 0 (use IndentWidth) or 1..32
CaseLabelIndentWidth = 0

# Values: 0 (use IndentWidth) or 1..32
BlockBodyIndentWidth = 0

# Values: Preserve | Indent | NoIndent
IndentNamespaces = Preserve

# Values: 0 (use IndentWidth) or 1..32
NamespaceIndentWidth = 0

# Applies to contents of braced extern "C" / extern "C++" blocks.
# Preserves body line breaks; single declarations without braces are unaffected.
# Values: Preserve | Indent | NoIndent
IndentLinkageBlocks = Preserve

# Values: 0 (use IndentWidth) or 1..32
LinkageIndentWidth = 0

# Values: Preserve | Indent
StandaloneBlockBraceIndentation = Preserve

# Values: Preserve | Block | Indent
StatementAttributeIndent = Preserve

# Values: 0 (use IndentWidth) or 1..32
StatementAttributeIndentWidth = 0

# Values: Preserve | 0..10000 | Minimum:0..10000
NamespaceBlankLinesAfterOpen = Preserve

# Values: Preserve | 0..10000 | Minimum:0..10000
NamespaceBlankLinesBeforeClose = Preserve

# Inside nonempty extern linkage blocks, outside attached comments.
# Example: set both LinkageBlankLinesAfterOpen and
# LinkageBlankLinesBeforeClose to 1 for a blank line at each edge.
# Values: Preserve | 0..10000 | Minimum:0..10000
LinkageBlankLinesAfterOpen = Preserve

# Inside nonempty extern linkage blocks, outside attached comments.
# Example: set both LinkageBlankLinesAfterOpen and
# LinkageBlankLinesBeforeClose to 1 for a blank line at each edge.
# Values: Preserve | 0..10000 | Minimum:0..10000
LinkageBlankLinesBeforeClose = Preserve

# Between access sections, including unlabeled initial members.
# Skips a label at the start of a record; outside attached comments.
# Example: 1 inserts a blank line between int Value; and private:.
# Values: Preserve | 0..10000 | Minimum:0..10000
AccessSectionBlankLinesBefore = Preserve

# Values: Preserve | 0..10000 | Minimum:0..10000
AccessSectionBlankLinesAfterLabel = Preserve

# Values: Preserve | 0..10000 | Minimum:0..10000
DeclarationBlankLines = Preserve

# Between different entity kinds: types, functions, variables.
# Overrides declaration/definition counts, including members.
# Types: records, enums, typedefs and using aliases.
# Templates and single exports follow their declared entity.
# Other declarations, directives and unattached comments stop grouping.
# Example: DeclarationBlankLines = 0 with this set to 1
# keeps like declarations together and separates categories.
# Values: Preserve | 0..10000 | Minimum:0..10000
DeclarationCategoryBlankLines = Preserve

# Values: Inherit | Preserve | 0..10000 | Minimum:0..10000
MemberDeclarationBlankLines = Inherit

# Values: Preserve | 0..10000 | Minimum:0..10000
DefinitionBlankLines = Preserve

# Values: Inherit | Preserve | 0..10000 | Minimum:0..10000
MemberDefinitionBlankLines = Inherit

# Between a case with statements and the next case/default label.
# Stacked empty labels stay together; includes attributed labels.
# The gap follows the whole body, including [[fallthrough]];.
# Attached label comments stay with their label.
# Directives and unparsed syntax stop case grouping.
# Example: 1 adds an empty line after work(); [[fallthrough]];
# before the next case. 0 removes empty lines; Preserve retains them.
# Values: Preserve | 0..10000 | Minimum:0..10000
CaseBlankLines = Preserve

# Values: Preserve | 0..10000 | Minimum:0..10000
StandaloneCommentBlankLinesBefore = Preserve

# Values: Preserve | 0..10000 | Minimum:0..10000
StandaloneCommentBlankLinesAfter = Preserve

# Values: Preserve | 0..10000
MaxEmptyLines = Preserve

# Override MaxEmptyLines only between adjacent fields and methods, or between
# two method definitions. Preserve uses the global cap. Does not infer groups.
# Unattached comments, access labels and directives stop adjacency.
# Example: MaxEmptyLines = 1, MemberGroupMaxEmptyLines = 2 retains authored
# double gaps at these boundaries; use MemberDefinitionBlankLines = Minimum:1
# to require separation without collapsing such groups.
# Values: Preserve | 0..10000
MemberGroupMaxEmptyLines = Preserve

# Between a brace-terminated block/control statement and its next sibling.
# Also follows braced do/while, definitions, namespaces and linkage blocks.
# Declaration/definition counts win. Skips scope edges and else/catch links.
# Initializer braces are not statement blocks. Comments stay attached.
# Example: 1 separates if (ready) { Run(); } from a following Finish();.
# Values: Preserve | 0..10000 | Minimum:0..10000
BlockBlankLinesAfter = Preserve

# Before sibling if/for/while statements, outside attached leading comments.
# No gap is added at the beginning of a body or after a case/ordinary label.
# Includes preceding declarations; optional semantic grouping is not inferred.
# Example: 1 separates Prepare(); from a following while (ready) { Run(); }.
# Values: Preserve | 0..10000 | Minimum:0..10000
ControlStatementBlankLinesBefore = Preserve

# Around complete expression statements rooted in BlankLineMacroNames.
# Consecutive invocations of the same name form a group with zero empty lines.
# Fluent suffixes belong to the statement. Skips body edges and nested calls.
# Example: 1 separates CHECK(ok); from Work(); above and below it.
# Values: Preserve | 0..10000 | Minimum:0..10000
MacroBlankLinesAround = Preserve

# Unqualified identifiers or prefixes ending in *; no built-in macro names.
# Selects only standalone call statements, including their fluent chains.
# Example: ["CHECK", "LOG_*"]
# Values: identifier/prefix array
BlankLineMacroNames = []

# Keep preceding arguments and the first complete string literal
# beside the opener; put every following format argument on its
# own line even when the call fits. Exact unqualified names,
# including members. Overrides both first-argument pin lists.
# CallLineMessageOverflow controls overflowing headers.
# Without a complete literal argument, use ordinary call layout.
# CallsLayout = Preserve, CallsBreak = Always and protection win.
# Example: CallLineMessageNames = ["LOG_MESSAGE"]
# LOG_MESSAGE(code, "Value: %v, count: %v",
#     value,
#     count);
# Values: [] or ["name", ...]
CallLineMessageNames = []

# Applies to CallLineMessageNames only.
# Wrap (default): wrap at argument boundaries before splitting
# nested expressions. Concatenated literals may wrap after a
# fitting first fragment beside the opener.
# KeepInline: keep preceding arguments and the complete message
# beside the opener, even past ColumnLimit. Required nested
# breaks, CallsBreak = Always, preserved calls and protection win.
# Example: with CallLineMessageNames = ["raise"], KeepInline keeps
# raise(condition, "A long message", value) through the message
# on the call line; value still moves to its own line.
# Values: Wrap | KeepInline
CallLineMessageOverflow = Wrap

# Exact names (including member calls), empty by default.
# Unqualified identifiers, not patterns.
# Keep any first argument beside the opener when it fits.
# Overrides CallLineFirstStringNames for shared names.
# Example: CallLineFirstArgumentNames = ["dispatch"]
# dispatch(value + offset, alpha, beta) can keep value
# beside '(' while later arguments move below.
# Values: [] or ["name", ...]
CallLineFirstArgumentNames = []

# Applies to CallLineFirstArgumentNames only.
# Wrap (default): ordinary wrapping within the argument.
# BreakBefore: move below the opener if the complete
# argument and its same-line punctuation do not fit.
# KeepInline: attach the opening piece, even over the limit.
# Nested expressions, initializers and lambdas may wrap.
# Always and protection win; preserved calls stay as-is.
# Values: Wrap | BreakBefore | KeepInline
CallLineFirstArgumentOverflow = Wrap

# Values: [] or ["name", ...]
CallLineFirstStringNames = []

# Complete string first arguments of configured names.
# Applies to CallLineFirstStringNames only.
# Wrap (default): ordinary wrapping between literal pieces.
# BreakBefore: move below the opener if the whole string
# sequence and its same-line punctuation do not fit.
# KeepInline: keep the first piece beside the opener, even
# over ColumnLimit; later concatenated pieces may wrap.
# Never splits literal contents. Always and protection win.
# Preserved call layout is unchanged. Example:
# CallLineFirstStringNames = ["message"]
# BreakBefore moves the string in
# message("first " "second", value) below the opener
# if the complete first argument will not fit beside it.
# Values: Wrap | BreakBefore | KeepInline
CallLineFirstStringOverflow = Wrap

# Exact qualified roots; only unambiguous templates match.
# ns::Builder<T>::Make<U> matches ns::Builder::Make.
# Omit the template disambiguator from configured names.
# Values: [] or ["qualified::name", ...]
ChainedCallRootNames = []

# Exact qualified roots; only unambiguous templates match.
# ns::Builder<T>::Make<U> matches ns::Builder::Make.
# Omit the template disambiguator from configured names.
# Values: [] or ["qualified::name", ...]
AlwaysBreakChainRootNames = []

# Start matching member calls on a new line, including in control headers.
# Exact unqualified names; omit template arguments and the template keyword.
# Obeys ChainsLayout and ChainedCallRootNames; overrides sticky pairs.
# Safety and protected regions still win.
# Example: ["Then"] splits before .Then() or ->Then(), not fields or roots.
# Values: [] or ["name", ...]
AlwaysBreakChainCallNames = []

# Case and ordinary labels delimit independent sections.
# Only complete pairs inside one section affect indentation.
# Uncertain unlabeled scopes retain line-start regions.
# Inline endpoints do not prevent body expansion.
# Values: [] or ["Begin:End", ...]
IndentedCallScopePairs = []

# Values: false | true
GenerateCallScopeIndentation = false

# Values: [] or ["Begin:End", ...]
IndentedChainScopePairs = []

# Values: [] or ["First:Second", ...]
StickyChainCallPairs = []

# Values: [] or ["name", ...]
CallLikeMacroNames = []

# Values: [] or ["name", ...]
FunctionBodyMacroNames = []

# YT-style enum macros: the final argument is a sequence of (Name) or
# ((Name)(value)) entries. Optional header arguments give the enum name
# and underlying type. Keep header arguments inline, put each entry
# on its own indented line, align value fields with one minimum space,
# and put the closing parenthesis on its own line.
# Value expressions retain their internal spelling. Unrecognized forms
# and WhitespaceSensitiveMacros stay protected.
# Example: EnumMacroNames = ["DEFINE_ENUM", "DEFINE_BIT_ENUM"]
# Values: [] or ["name", ...]
EnumMacroNames = []

# Begin:End pairs of unqualified function-like macro names.
# Endpoints must be distinct and unique across pairs.
# Nested classes close with their configured matching end.
# Arguments stay intact; no expanded types are inferred.
# Example: ClassMacroNames = ["BEGIN_SETTER:END_SETTER"]
# Values: [] or ["Begin:End", ...]
ClassMacroNames = []

# Values: [] or ["name", ...]
WhitespaceSensitiveMacros = []

# Preserve keeps directive indentation and spacing after # or %:.
# Indent moves the whole directive by conditional nesting depth
# using IndentWidth spaces; NoIndent puts it at column one.
# Indent and NoIndent remove spaces after the marker.
# Example with IndentWidth = 4: a nested #if becomes "    #if".
# else/elif/endif align with their if.
# Legacy true means Indent; false means Preserve.
# Values: Preserve | Indent | NoIndent (also false | true)
IndentPreprocessingDirectives = Preserve

# Values: false | true
AlignMacroBackslashes = false

# Values: 0 (preserve) or 3..10000
RulerLength = 0

# NamespaceBoundaries adds rulers inside namespace openings and before closings.
# Initial using namespace directives stay with the opening. Existing ruler
# placement is preserved, including between declarations and inside bodies.
# New rulers use RulerLength, or 80 when it is 0. Protection and directives
# take precedence.
# Values: Preserve | NamespaceBoundaries
RulerPlacement = Preserve

# Values: Preserve | 0..10000 | Minimum:0..10000
RulerBlankLinesBefore = Preserve

# Values: Preserve | 0..10000 | Minimum:0..10000
RulerBlankLinesAfter = Preserve

# Values: Preserve | Sort
IncludeOrder = Preserve

# Values: QuotedFirst | AngledFirst
IncludeCategoryOrder = QuotedFirst

# Values: Preserve | QuotedLocal
IncludeDelimiters = Preserve

# Values: Off | First
IncludeMatchingHeader = Off

# Values: Preserve | Regroup | Directory
IncludeGrouping = Preserve

# Values: [] or [{Prefix = "directory/", Depth = 127, Priority = 0}, ...]
# Entries without a trailing / match exact header names.
# A rule may use StandardHeaders = true alone or with Prefix/Prefixes.
IncludeGroups = []

# Values: Directory | Configured
IncludeGroupOrder = Directory

# Values: NearestFirst | Alphabetical
IncludeDirectoryOrder = NearestFirst

# Values: Alphabetical | NearestFirst
IncludeInGroupOrder = Alphabetical

# Values: SourceDirectory | ProjectRoot
IncludePathBase = SourceDirectory

# Values: Preserve | Last
IncludeStandardHeaders = Preserve

# Values: false | true
AddMissingControlBraces = false

# Remove only beside known syntax or sequence boundaries.
# Unknown syntax and macro bodies retain semicolons.
# Example: struct CLASS_NAME(Example) {}; keeps its ';'.
# Values: false | true
RemoveNullStatements = false

# Remove only beside known syntax or sequence boundaries.
# Unknown syntax and macro bodies retain semicolons.
# Example: struct CLASS_NAME(Example) {}; keeps its ';'.
# Remove redundant null declarations.
# Required semicolons stay intact.
# Same-line namespace suffixes are removed beside comments:
# namespace N {}; // note becomes namespace N {} // note.
# Standalone commented placeholders stay intact.
# Values: false | true
RemoveNullDeclarations = false

# Values: Preserve | EmptyBlock
EmptyControlBody = Preserve

# Values: Preserve | Remove | AddMissing | Fix
# Fix and Remove rewrite only namespace closing labels (// namespace Name
# or a bare matching namespace name). Explanatory comments stay intact.
# Fix and AddMissing still report a missing label when an explanatory
# comment prevents a safe fix. ShortNamespaceLines exemptions apply.
NamespaceComments = Preserve

# Values: Preserve | 0..10000 (omitted: TrailingCommentSpacing)
# TrailingCommentSpaces = Preserve

# Values: 1..32
NamespaceCommentSpaces = 1

# Values: 0 (no exemption) or 1..10000
ShortNamespaceLines = 0

# Between consecutive word specifiers in declarations and types.
# Example: static   const   int becomes static const int with Space.
# Balanced decltype/alignas/extension operands keep their own rules.
# Preserve keeps horizontal spelling even with canonical layout;
# Space applies even with preserved layout. Lexical safety overrides NoSpace.
# Comments and protected/opaque syntax stay intact; layout controls breaks.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
DeclarationSpecifierSpacing = GeneratedSpace

# Between a parsed type and its declarator name, also in parameters.
# Examples: int   value; Box<int>   value; decltype(item)   value;
# Pointer binding, packs and nested declarators retain their own rules.
# Preserve keeps horizontal spelling even with canonical layout;
# Space applies even with preserved layout. Lexical safety overrides NoSpace.
# Comments and protected/opaque syntax stay intact; layout controls breaks.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
DeclarationNameSpacing = GeneratedSpace

# Space between return and its ordinary operand.
# Example: return value;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
ReturnValueSpacing = Preserve

# Space between co_return and its ordinary operand.
# Example: co_return value;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
CoReturnValueSpacing = Preserve

# Space between throw and its ordinary operand.
# Example: throw value;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
ThrowOperandSpacing = Preserve

# Space between co_yield and its operand.
# Example: co_yield value;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
CoYieldValueSpacing = Preserve

# Space between co_await and its ordinary operand.
# CoAwaitSpaceBeforeParentheses controls parenthesized operands.
# Example: co_await task;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
CoAwaitOperandSpacing = Preserve

# Space between goto and its label.
# Example: goto done;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
GotoLabelSpacing = Preserve

# Space between case and its expression.
# Example: case 1:
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
CaseValueSpacing = Preserve

# Space before the type of a new-expression.
# Example: new Widget;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
NewTypeSpacing = Preserve

# Space before a delete operand; array-specific rules win.
# Example: delete pointer;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
DeleteOperandSpacing = Preserve

# Spaces between base specifiers and the complete base type.
# Example: public virtual Base
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
BaseSpecifierSpacing = Preserve

# Space before a confirmed pack ellipsis, including sizeof....
# Example: Types...
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
PackExpansionSpaceBeforeEllipsis = GeneratedNoSpace

# Space after a confirmed pack ellipsis; specific rules win.
# Example: Types... values
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
PackExpansionSpaceAfterEllipsis = GeneratedSpace

# Space before the name of a type template parameter.
# Example: class Element
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
TemplateParameterNameSpacing = Preserve

# Space after a complete template header; layout controls breaks.
# Example: template<class T> void F();
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
TemplateHeaderSpacing = GeneratedSpace

# Space between class/struct/union and its name.
# Example: struct Widget
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
RecordNameSpacing = Preserve

# Space between enum and class/struct.
# Example: enum class Flag
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
EnumKeywordSpacing = Preserve

# Space before the enumeration name.
# Example: enum class Flag
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
EnumNameSpacing = Preserve

# Space between namespace and its name.
# Example: namespace Detail
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
NamespaceNameSpacing = Preserve

# Spaces after using and namespace/typename introducers.
# Example: using namespace Detail;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
UsingKeywordSpacing = Preserve

# Space after import, outside header-name contents.
# Example: import module_name;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
ImportKeywordSpacing = Preserve

# Space after module, outside partition punctuation.
# Example: module module_name;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
ModuleKeywordSpacing = Preserve

# Space between export and its declaration or opening brace.
# Example: export class Widget;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
ExportKeywordSpacing = Preserve

# Space between extern and the language string.
# Example: extern "C"
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
LinkageLanguageSpacing = Preserve

# Space before a language-linkage opening brace.
# Example: extern "C" {
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
LinkageBraceSpacing = Preserve

# Spaces inside language-linkage braces.
# Example: extern "C" { int F(); }
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
LinkageBodyInteriorSpacing = Preserve

# Spaces inside export-block braces.
# Example: export { int F(); }
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
ExportBodyInteriorSpacing = Preserve

# Space before a module partition colon.
# Example: module_name:part
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
ModulePartitionColonSpaceBefore = Preserve

# Space after a module partition colon.
# Example: module_name:part
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
ModulePartitionColonSpaceAfter = Preserve

# Space between concept and its name.
# Example: concept Predicate = true;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
ConceptNameSpacing = Preserve

# Space before a parsed requires clause.
# Example: void F() requires Predicate;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
RequiresClauseSpaceBefore = Preserve

# Space after requires in clauses and nested requirements.
# Example: requires Predicate<T>
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
RequiresClauseSpaceAfter = Preserve

# Space before a requires-expression body.
# Example: requires(T t) {
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
RequiresExpressionSpaceBeforeBrace = Preserve

# Spaces inside compound-requirement expression braces.
# Example: { value() } noexcept;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
CompoundRequirementInteriorSpacing = GeneratedSpace

# Space before a compound requirement's constraint arrow.
# Example: { value() } -> Concept;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
TypeConstraintSpaceBefore = GeneratedSpace

# Space after a compound requirement's constraint arrow.
# Example: { value() } -> Concept;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
TypeConstraintSpaceAfter = GeneratedSpace

# Space before a function try-block introducer.
# Example: void F() try {}
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
FunctionTryBlockSpacing = GeneratedSpace

# Space before a parsed class final specifier.
# Example: struct Widget final
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
RecordFinalSpacing = GeneratedSpace

# Space after a complete alignas specifier.
# Example: alignas(16) int value;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
AlignasSpaceAfterSpecifier = GeneratedSpace

# Space before leading global ::, not between qualifiers.
# Example: const ::Detail::Type
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
LeadingScopeResolutionSpacing = Preserve

# Space before a control-header semicolon.
# Example: for (int i = 0; i < 2; ++i)
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
ControlHeaderSemicolonSpaceBefore = GeneratedNoSpace

# Horizontal space between complete sibling statements/declarations.
# Example: first(); second();
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
StatementSequenceSpacing = GeneratedSpace

# Spaces beside ordinary block comments; argument rules win.
# Example: value /* note */
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
BlockCommentSpacing = Preserve

# Spaces before else/catch/do-while suffixes and in else if.
# Example: if (x) {} else if (y) {}
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
ControlClauseSpacing = GeneratedSpace

# Space before a controlled statement; brace-specific rules win.
# Example: if (x) Use();
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
ControlBodySpacing = Preserve

# Spaces inside a noexcept specifier's outer parentheses.
# Example: noexcept(test)
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
NoexceptSpecifierInteriorSpacing = Preserve

# Spaces inside an operator() or operator[] name.
# Example: operator()
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
OperatorNameInteriorSpacing = Preserve

# Space inside delete-array brackets.
# Example: delete [] pointer;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
DeleteArrayInteriorSpacing = Preserve

# Space before a structured binding's opening bracket.
# Example: auto [first, second] = value;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
StructuredBindingSpaceBeforeBrackets = Preserve

# Space before a member-pointer's owner qualifier.
# Example: int Owner::*member;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
MemberPointerSpaceBeforeQualifier = Preserve

# Space before nested-declarator parentheses.
# Example: int (*callback)(int);
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
NestedDeclaratorSpaceBeforeParentheses = Preserve

# Spaces between consecutive pointer cv-qualifiers.
# Example: int* const volatile pointer;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
PointerQualifierSpacing = Preserve

# Space between adjacent string-literal fragments.
# Example: "left" "right"
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
StringLiteralFragmentSpacing = GeneratedSpace

# Spaces between a parsed asm introducer and its modifiers.
# Example: asm volatile ("nop");
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
AsmKeywordSpacing = Preserve

# Space before an asm declaration's operand parentheses.
# Example: asm ("nop");
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
AsmSpaceBeforeParentheses = Preserve

# Spaces inside an asm declaration's outer parentheses.
# Example: asm ( "nop" );
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
AsmInteriorSpacing = Preserve

# Spaces before constexpr/consteval/co_await control modifiers.
# Example: if constexpr (ready) {}
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
ControlKeywordModifierSpacing = Preserve

# Space after template in a confirmed dependent name.
# Example: object.template Method<int>();
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
DependentTemplateNameSpacing = Preserve

# Space after typename in a confirmed dependent type name.
# Example: typename T::type value;
# Preserve retains horizontal spelling; layout still controls line breaks.
# Lexical safety and protected/opaque syntax override spacing preferences.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
DependentTypeNameSpacing = Preserve

# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
TrailingCommentSpacing = Preserve

# Between a call argument or braced initializer element and
# its leading/trailing block comments, for any value kind.
# After the last leading and before the first trailing one,
# and between consecutive block comments in attached runs.
# Leading /*name*/ or /*name=*/ label-to-value gaps use
# ArgumentNameCommentSpacing instead.
# Space: consume(/* first note */ /* second note */ value /* note */);
# NoSpace: consume(/* first note *//* second note */value/* note */);
# Default: Preserve, keeping original horizontal spelling.
# Choose Space explicitly to normalize horizontal gaps.
# Generated* applies when the owning list is rebuilt.
# Only block-to-block and block-to-argument gaps qualify.
# Newlines, line comments, interiors, separator-facing gaps
# and protections stay put.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
ArgumentCommentSpacing = Preserve

# After a leading /*name*/ or /*name=*/ label before a call
# argument or braced initializer element. Surrounding spaces
# and tabs are accepted, e.g. /* name */ or /* name = */.
# Any single identifier is a label. Contents are unchanged.
# Space: consume(/*count*/ size, /*count=*/ size, /* a note */ value);
# NoSpace: consume(/*count*/size, /*count=*/size, /* a note */ value);
# Gaps between comments and before trailing comments use
# ArgumentCommentSpacing, even for label-shaped comments.
# Default: Preserve. Generated* needs the list rebuilt.
# Newlines and protected spans stay put.
# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
ArgumentNameCommentSpacing = Preserve

# Values: Preserve | Space | NoSpace | GeneratedSpace | GeneratedNoSpace
NamedCastSpaceBeforeOperandParentheses = Preserve

