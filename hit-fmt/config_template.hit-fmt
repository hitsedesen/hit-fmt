# Exempt the entry-point name main and standard library extension function
# names from case, affix and acronym checks: begin, end, cbegin, cend,
# rbegin, rend, crbegin, crend, size, ssize, empty, data, swap, get,
# iter_move and iter_swap.
# Applies to member and free function definitions by exact name only;
# signatures are not verified. Other categories and parameter-name presence
# checks are unaffected. Custom exemptions work with either setting.
NamingStandardLibraryExemptions = false

# Additional exemptions for all categories, alongside category NameExemptions.
# Exact, case-sensitive, unqualified identifiers, e.g. ["external_name"].
# Lists replace inherited lists; [] clears custom exemptions.
NamingExemptions = []

# Known acronyms: uppercase words of at least two letters; [] disables checks.
# For camelCase/PascalCase only: two-letter words uppercase, longer words
# capitalized; initial camelCase words lowercase. Example: IOCount, TcpCount,
# ioCount. Match whole camel-case words ignoring case, never substrings.
# Digits delimit words; unknown words and ambiguous boundaries stay unchecked.
# Use unambiguous vocabulary: CH can mean ClickHouse or character.
NamingAcronyms = []

# Configuration inheritance (optional)
# Relative paths start here; absolute filesystem paths work too.
# @/ starts at the nearest ancestor with a .git or .arc marker
# (file or directory, including worktrees).
# Local settings override the base regardless of include position.
# Lists replace inherited lists; [] clears them.
# Validation uses merged settings. Nested includes: 64 files max.
# Cycles, missing files and duplicate includes are errors.
# include = "base.hit-fmt"
# include = "@/configs/base.hit-fmt"

# Other configuration options

# Values: [] or ["qualified::name", ...]
NamingNamespaceExemptions = ["std"]

# Values: Unchecked | Required
FunctionDeclarationParameterNames = Unchecked

# Values: Unchecked | NameRequired | NameOrCommentedNameRequired
FunctionDefinitionParameterNames = Unchecked

# Values: [] or ["path regex", ...]
Exclude = []
