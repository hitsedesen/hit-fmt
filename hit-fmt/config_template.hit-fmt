# Naming checks report diagnostics only, including with --fix.
# Inherit leaves the category unspecified; Unchecked explicitly disables case.
# A configured role replaces the whole fallback rule, including affixes and
# exemptions. Set NameCase = Unchecked to select a role with no case check.
# Variable role fallback, from most specific to least specific:
# Parameter -> Variable; GlobalVariable -> Variable;
# StaticLocalVariable -> LocalVariable -> Variable;
# StaticMemberVariable -> access-specific member -> MemberVariable -> Variable.
# Non-static members start at their access-specific rule.
# Any non-Inherit case, nonempty affix list or exemption list selects a rule.
# Affix [] disables that affix check; [""] explicitly permits no affix.
# Case/acronym checks apply after removing a matching prefix and suffix.
# Exemptions are exact, case-sensitive, unqualified identifier names.
# Anonymous-union members use their enclosing scope and access rule.
# Parameter rules also check named parameters in function declarations.
# Function names and forward type names remain definition-only checks.
# Native enumerators and entries/types in configured EnumMacroNames are checked.

# Values: Inherit | Unchecked | camelCase | PascalCase | snake_case | SCREAMING_SNAKE_CASE
ClassNameCase = Inherit

# Values: [] (disabled) or ["prefix", ...]; [""] permits no prefix.
ClassNamePrefixes = []

# Values: [] (disabled) or ["suffix", ...]; [""] permits no suffix.
ClassNameSuffixes = []

# Values: [] or ["identifier", ...]
ClassNameExemptions = []

# Values: Inherit | Unchecked | camelCase | PascalCase | snake_case | SCREAMING_SNAKE_CASE
EnumNameCase = Inherit

# Values: [] (disabled) or ["prefix", ...]; [""] permits no prefix.
EnumNamePrefixes = []

# Values: [] (disabled) or ["suffix", ...]; [""] permits no suffix.
EnumNameSuffixes = []

# Values: [] or ["identifier", ...]
EnumNameExemptions = []

