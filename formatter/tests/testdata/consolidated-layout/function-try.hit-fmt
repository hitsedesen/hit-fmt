Layout = Canonical
ColumnLimit = 80
IndentWidth = 2
IndentationKind = Spaces
BinaryOperatorSpacing = GeneratedSpace
AssignmentOperatorSpacing = GeneratedSpace
TernaryOperatorSpacing = GeneratedSpace
MemberAccessOperatorsSpacing = GeneratedNoSpace
FunctionCallSpaceBeforeParameters = GeneratedNoSpace
FunctionSpaceBeforeParameters = GeneratedNoSpace
StatementSemicolonSpacing = GeneratedNoSpace
DeclarationSemicolonSpacing = GeneratedNoSpace
FunctionBracePlacement = NextLineIfHeaderBroken
