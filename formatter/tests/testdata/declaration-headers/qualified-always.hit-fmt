Layout = Canonical
ColumnLimit = 80
IndentWidth = 4
IndentationKind = Spaces
FunctionBracePlacement = NextLineIfHeaderBroken
PointerReferenceDeclaratorLocation = Left
FunctionSpaceBeforeParameters = NoSpace
SpaceInsideFunctionParameters = NoSpace
ReturnArrowSpaceBefore = Space
ReturnArrowSpaceAfter = Space
TemplateArgumentsBreak = Always
TemplateArgumentsFirstItem = NextLine
TemplateArgumentsPacking = VerticalWhenBroken
