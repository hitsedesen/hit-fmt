Layout = Canonical
IndentationKind = Spaces
IndentWidth = 2
ContinuationOffset = 4
ColumnLimit = 80
ChainsBreak = Always
ChainsPacking = VerticalWhenBroken
ChainsAlignment = Block
StickyChainCallPairs = ["Item:Value", "Item:BeginMap", "Item:BeginList", "Append:Append", "registrar:Parameter", "Maker:Parameter"]
