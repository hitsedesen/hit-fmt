# Explicit inheritance, source ownership and all shared policy families.
Layout = Canonical
IndentWidth = 2
ColumnLimit = 80
WidthDiagnostics = Report
IndentationKind = Tabs
TrailingWhitespace = Trim
PointerReferenceDeclaratorLocation = Right
IndentAccessModifiers = Indent
AccessModifierIndentWidth = 1
IndentMembers = NoIndent
MemberIndentWidth = 0
IndentNamespaces = NoIndent
NamespaceIndentWidth = 0
IndentCaseLabels = Indent
CaseLabelIndentWidth = 3
StandaloneBlockBraceIndentation = Indent
StatementAttributeIndent = Indent
StatementAttributeIndentWidth = 4
ListBreak = Always
ListPacking = Fill
ListAlignment = Delimiter
ContinuationOffset = 4
AlignmentFallbackOffset = 0
CallsBreak = IfNeeded
CallsPacking = VerticalWhenBroken
CallsFirstItem = NextLine
CallsSoleArgumentFirstItem = InlineIfFits
CallsCloser = OwnLine
CallsAlignment = Inherit
ParametersLayout = Preserve
ParametersContinuationOffset = 3
ControlHeadersAlignmentFallbackOffset = 6
EnumeratorsLayout = Inherit
EnumeratorsPacking = VerticalWhenBroken
EnumeratorsFirstItem = NextLine
EnumeratorsCloser = OwnLine
EnumeratorsAlignment = Block
EnumeratorsContinuationOffset = 0
EnumeratorsAlignmentFallbackOffset = 7
EnumBracePlacement = NextLineIfHeaderBroken
ExpressionsLayout = Inherit
ExpressionsBreak = Always
ExpressionsPacking = VerticalWhenBroken
ChainsBreak = Always
TernaryLayout = ThreePart
BodiesLayout = Preserve
LambdaBodiesLayout = Inherit
LambdaBodyShape = CompactIfFits
EmptyBodyShape = CompactIfFits
LambdaEmptyBodyShape = Inherit
NamespaceBlankLinesAfterOpen = 2
NamespaceBlankLinesBeforeClose = 0
AccessSectionBlankLinesBefore = 1
AccessSectionBlankLinesAfterLabel = 0
DefinitionBlankLines = 2
MemberDefinitionBlankLines = Inherit
MaxEmptyLines = 2
ControlBracePlacement = NextLineIfHeaderBroken
InitializersTrailingComma = WhenMultiline
CommaSpaceAfter = GeneratedSpace
EmptyBlockInteriorSpacing = Preserve
WhitespaceSensitiveMacros = [
    "STRINGIZE_TEXT", # Semantically observable whitespace.
    "ENUM_DSL"
]
CallLineFirstStringNames = ["WRITE_MESSAGE", "TRACE_MESSAGE"]
ChainedCallRootNames = ["ns::BuildPipeline", "MAKE_MESSAGE"]
AlwaysBreakChainRootNames = ["ns::BuildPipeline", "WRITE_EVENT"]
IndentedCallScopePairs = ["StartMap:FinishEntries", "StartList:FinishSequence"]
IndentedChainScopePairs = ["OpenChain:CloseChain", "OpenList:CloseList"]
StickyChainCallPairs = ["Choose:Write", "Choose:OpenChain", "Append:Append"]
CallLikeMacroNames = ["REGISTER_NODE"]
ClassNameCase = PascalCase
FunctionDeclarationParameterNames = Required
Exclude = ["(^|/)generated(/|$)"]
