# Shape preferences apply when broken; fitting canonical groups flatten.
ColumnLimit = 50
EmptyBlockInteriorSpacing = Space
BlockInteriorSpacing = Space
EmptyLambdaBodySpacing = NoSpace
LambdaBodiesLayout = Canonical
LambdaBodyShape = CompactIfFits
# Empty and nonempty lambda shapes are independent.
LambdaEmptyBodyShape = CompactIfFits
