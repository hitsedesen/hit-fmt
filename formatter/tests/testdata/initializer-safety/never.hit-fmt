# Root checkpoint's canonical list/initializer policy.
Layout = Canonical
IndentWidth = 4
ColumnLimit = 80
IndentationKind = Spaces
ListBreak = IfNeeded
ListPacking = VerticalWhenBroken
ListFirstItem = NextLine
ListCloser = SameLine
ListAlignment = Block
ContinuationOffset = 4
AlignmentFallbackOffset = 4
InitializersCloser = OwnLine
FunctionBracePlacement = NextLine
ControlBracePlacement = NextLineIfHeaderBroken
BodyShape = Expanded
AddMissingControlBraces = true
BraceInitializerSpacing = NoSpace
RangeBasedForColonSpacing = Space
CommaSpaceBefore = NoSpace
CommaSpaceAfter = Space
FunctionSpaceBeforeParameters = NoSpace
FunctionCallSpaceBeforeParameters = NoSpace
StatementSemicolonSpacing = NoSpace
DeclarationSemicolonSpacing = NoSpace
AssignmentOperatorSpacing = Space
InitializersTrailingComma = Never
