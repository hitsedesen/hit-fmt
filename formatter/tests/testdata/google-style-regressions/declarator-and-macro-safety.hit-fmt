# Migrated to group policies; legacy output equivalence is not implied.
# Shape preferences apply when broken; fitting canonical groups flatten.
IndentWidth = 2
ColumnLimit = 80
CallsLayout = Canonical
CallsPacking = Fill
ExpressionsLayout = Canonical
PointerReferenceDeclaratorLocation = Left
BinaryOperatorSpacing = Space
UnaryOperatorSpacing = NoSpace
CommaSpaceBefore = NoSpace
CommaSpaceAfter = Space
SpaceInsideCallArguments = NoSpace
FunctionCallSpaceBeforeParameters = NoSpace
LambdaBraceSpacing = Space
BodiesLayout = Canonical
BodyShape = Expanded
BraceInitializerSpacing = NoSpace
CastSpacing = NoSpace
