# Shape preferences apply when broken; fitting canonical groups flatten.
# Visual scopes need generated indentation; global Preserve wins otherwise.
IndentationKind = Spaces
BodiesLayout = Canonical
BodyShape = Expanded
# Explicit library annotations; no renderer identifier checks.
IndentedCallScopePairs = ["OnBeginList:OnEndList", "OnBeginMap:OnEndMap", "OnBeginAttributes:OnEndAttributes"]
