# Shape preferences apply when broken; fitting canonical groups flatten.
ClassBracePlacement = NextLine
DeclarationHeadersLayout = Canonical
ClassBraceSpacing = Space
StructBracePlacement = Attached
StructBraceSpacing = Space
UnionBraceSpacing = GeneratedSpace
EnumBraceSpacing = Space
FunctionBracePlacement = Attached
FunctionBraceSpacing = Space
LambdaBracePlacement = Attached
LambdaBraceSpacing = GeneratedSpace
NamespaceBracePlacement = NextLine
NamespaceBraceSpacing = Space
