ColumnLimit = 32
FunctionParameterSplit = OnePerLine
EnforceFunctionParameterSplit = true
CallArgumentSplit = OnePerLine
EnforceCallArgumentSplit = true
FunctionParameterClosingParenthesis = NewLine
FunctionCallArgumentClosingParenthesis = NewLine
EnforceFunctionParameterClosingParenthesis = false
EnforceFunctionCallArgumentClosingParenthesis = false
