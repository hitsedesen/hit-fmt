# Migrated to group policies; legacy output equivalence is not implied.
# Shape preferences apply when broken; fitting canonical groups flatten.
AddMissingControlBraces = true
EmptyControlBody = EmptyBlock
ControlBlockSpaceBeforeBrace = GeneratedNoSpace
EmptyBlockInteriorSpacing = GeneratedSpace
ControlHeadersLayout = Canonical
ControlBracePlacement = Attached
BodiesLayout = Canonical
BodyShape = CompactIfFits
