Layout = Canonical
IndentationKind = Spaces
ColumnLimit = 64
IndentWidth = 4
TemplateParametersLayout = Canonical
TemplateParametersBreak = IfNeeded
TemplateParametersPacking = VerticalWhenBroken
TemplateParametersFirstItem = NextLine
TemplateParametersCloser = OwnLine
TemplateParametersAlignment = Block
TemplateParametersContinuationOffset = 4
TemplateParametersAlignmentFallbackOffset = 4
TemplateArgumentsLayout = Canonical
TemplateArgumentsPacking = Fill
TemplateArgumentsFirstItem = InlineIfFits
TemplateArgumentsCloser = SameLine
TemplateKeywordSpacing = Space
TemplateTypeArgumentInteriorSpacing = NoSpace
CommaSpaceAfter = Space
WhitespaceSensitiveMacros = ["OPAQUE"]
