Layout = Canonical
IndentationKind = Spaces
ColumnLimit = 64
IndentWidth = 4
ListPacking = Fill
ListFirstItem = InlineIfFits
ListCloser = SameLine
ListAlignment = Block
TemplateParametersLayout = Inherit
TemplateParametersBreak = Inherit
TemplateParametersPacking = Inherit
TemplateParametersFirstItem = Inherit
TemplateParametersCloser = Inherit
TemplateParametersAlignment = Inherit
TemplateParametersContinuationOffset = Inherit
TemplateParametersAlignmentFallbackOffset = Inherit
TemplateArgumentsLayout = Preserve
TemplateKeywordSpacing = Space
TemplateTypeArgumentInteriorSpacing = NoSpace
CommaSpaceAfter = Space
WhitespaceSensitiveMacros = ["OPAQUE"]
