# Shape preferences apply when broken; fitting canonical groups flatten.
IndentWidth = 2
ColumnLimit = 50
ExpressionsLayout = Canonical
ControlHeadersLayout = Canonical
ControlHeadersAlignment = Delimiter
BodiesLayout = Canonical
BodyShape = Expanded
IndentCaseLabels = NoIndent
StatementAttributeIndent = Block
AssignmentOperatorSide = Trailing
CallsLayout = Canonical
CallsPacking = Fill
CallsAlignment = Delimiter
InitializersLayout = Canonical
InitializersPacking = Fill
InitializersAlignment = Delimiter
NamespaceComments = Fix
ShortNamespaceLines = 1
