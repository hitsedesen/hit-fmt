# Migrated to group policies; legacy output equivalence is not implied.
# Shape preferences apply when broken; fitting canonical groups flatten.
ConstructorListsLayout = Canonical
ConstructorListsColonSide = Trailing
ConstructorListsColonSpaceBefore = NoSpace
ConstructorListsColonSpaceAfter = NoSpace
ConstructorListsCommaSide = Trailing
CommaSpaceBefore = Space
CommaSpaceAfter = NoSpace
ConstructorListsFirstItem = InlineIfFits
ConstructorListsPacking = Fill
ConstructorListsContinuationOffset = 2
ColumnLimit = 120
