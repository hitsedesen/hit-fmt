Layout = Canonical
IndentationKind = Spaces
IndentWidth = 4
ColumnLimit = 80
FunctionBracePlacement = NextLineIfHeaderIndented
ConstructorBracePlacement = NextLineIfHeaderIndented
DestructorBracePlacement = Inherit
ControlBracePlacement = NextLineIfHeaderIndented
ClassBracePlacement = NextLineIfHeaderIndented
StructBracePlacement = NextLineIfHeaderIndented
LambdaBracePlacement = NextLineIfHeaderIndented
ParametersBreak = Always
ParametersPacking = VerticalWhenBroken
ParametersFirstItem = NextLine
ParametersCloser = OwnLine
ParametersAlignment = Block
ControlHeadersBreak = Always
ControlHeadersFirstItem = NextLine
ControlHeadersCloser = OwnLine
ControlHeadersAlignment = Block
ConstructorListsBreak = Always
ConstructorListsPacking = VerticalWhenBroken
ConstructorListsFirstItem = NextLine
ConstructorListsAlignment = Block
ConstructorListsColonSide = Trailing
ConstructorListsCommaSide = Trailing
ConstructorListsColonSpaceBefore = Space
ConstructorListsColonSpaceAfter = Space
BaseListsBreak = Always
BaseListsPacking = VerticalWhenBroken
BaseListsFirstItem = NextLine
BaseListsAlignment = Block
BaseListsColonSide = Trailing
BaseListsCommaSide = Trailing
BaseListsColonSpaceBefore = Space
BaseListsColonSpaceAfter = Space
