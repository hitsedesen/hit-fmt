Layout = Canonical
IndentWidth = 4
ColumnLimit = 60
IndentationKind = Tabs
CallsBreak = Always
CallsFirstItem = NextLine
CallsAlignment = Block
ExpressionsBreak = Always
InitializersBreak = Always
InitializersFirstItem = NextLine
InitializersCloser = OwnLine
ControlHeadersFirstItem = InlineIfFits
ControlHeadersAlignment = Block
ControlBracePlacement = NextLineIfHeaderBroken
